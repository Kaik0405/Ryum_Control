<Window x:Class="GestionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionApp"
        xmlns:vm="clr-namespace:GestionApp.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Titulo}" 
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Conversor para el indicador de selección -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ========== SIDEBAR — RYUM CONTROL ========== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0D1B3E" Offset="0"/>
                    <GradientStop Color="#132B5E" Offset="0.3"/>
                    <GradientStop Color="#0F2247" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- ══ LOGO / BRANDING ══ -->
                <Border Grid.Row="0" Padding="0,28,0,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0A1832" Offset="0"/>
                            <GradientStop Color="#112952" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Logo icónico -->
                        <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1976D2" Offset="0"/>
                                    <GradientStop Color="#2196F3" Offset="0.5"/>
                                    <GradientStop Color="#26A69A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="R" FontSize="26" FontWeight="ExtraBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="R Y U M   C O N T R O L" 
                                   FontSize="14" FontWeight="Bold" Foreground="White" 
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Management System" 
                                   FontSize="10" Foreground="#5C7AA7" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0"
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                
                <!-- ══ MENÚ DE NAVEGACIÓN ══ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,6,0,0">
                    <StackPanel Margin="10,0,10,0">
                        
                        <!-- ─── Inicio ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Inicio, Mode=OneWay}"
                                     Command="{Binding NavigateToDashboardCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Inicio">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" 
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Inicio" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- Separador GESTIÓN -->
                        <Border Margin="6,16,6,8" Opacity="0.15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.3"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Height="1"/>
                        </Border>
                        <TextBlock Text="G E S T I Ó N" FontSize="10" Foreground="#4A6485" 
                                   Margin="14,0,0,6" FontWeight="Bold"/>
                        
                        <!-- ─── Inventario ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Inventario, Mode=OneWay}"
                                     Command="{Binding NavigateToInventarioCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Inventario">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M20 2H4c-1 0-2 1-2 2v3c0 .7.4 1.4 1 1.7V20c0 1 1 2 2 2h14c1 0 2-1 2-2V8.7c.6-.3 1-1 1-1.7V4c0-1-1-2-2-2zM9 18v-4h6v4H9zm11 0h-4v-5c0-.6-.4-1-1-1H9c-.6 0-1 .4-1 1v5H5V9h15v9zm1-13H3V4h18v1z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Inventario" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- ─── Combos ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Combos, Mode=OneWay}"
                                     Command="{Binding NavigateToCombosCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Combos">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Combos" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- ─── Entregas ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Entregas, Mode=OneWay}"
                                     Command="{Binding NavigateToEntregasCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Entregas">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M19 7c0-1.1-.9-2-2-2h-3c0-1.7-1.3-3-3-3S8 3.3 8 5H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V7zm-7-2c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1zm-2 14l-4-4 1.4-1.4L10 16.2l6.6-6.6L18 11l-8 8z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Entregas" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- ─── Fichas de Costo ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Fichas de Costo, Mode=OneWay}"
                                     Command="{Binding NavigateToFichasCostoCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Fichas de Costo">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm1 10h-2v2c0 .6-.4 1-1 1s-1-.4-1-1v-2H9c-.6 0-1-.4-1-1s.4-1 1-1h2V8c0-.6.4-1 1-1s1 .4 1 1v2h2c.6 0 1 .4 1 1s-.4 1-1 1zm-2-6V3.5L17.5 8H13z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Fichas de Costo" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- Separador FINANZAS -->
                        <Border Margin="6,16,6,8" Opacity="0.15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.3"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Height="1"/>
                        </Border>
                        <TextBlock Text="F I N A N Z A S" FontSize="10" Foreground="#4A6485" 
                                   Margin="14,0,0,6" FontWeight="Bold"/>
                        
                        <!-- ─── Finanzas ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Finanzas, Mode=OneWay}"
                                     Command="{Binding NavigateToMovimientosCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Finanzas">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Finanzas" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- ─── Reportes ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Reportes, Mode=OneWay}"
                                     Command="{Binding NavigateToReportesCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Reportes">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- Separador SISTEMA -->
                        <Border Margin="6,16,6,8" Opacity="0.15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.3"/>
                                    <GradientStop Color="#5C7AA7" Offset="0.7"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Height="1"/>
                        </Border>
                        <TextBlock Text="S I S T E M A" FontSize="10" Foreground="#4A6485" 
                                   Margin="14,0,0,6" FontWeight="Bold"/>
                        
                        <!-- ─── Ajustes ─── -->
                        <RadioButton GroupName="Nav" IsChecked="{Binding MenuSeleccionado, Converter={StaticResource MenuCheckConverter}, ConverterParameter=Ajustes, Mode=OneWay}"
                                     Command="{Binding NavigateToAjustesCommand}"
                                     Style="{StaticResource SidebarNavStyle}" Tag="Ajustes">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,12,0">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                          Stretch="Uniform"/>
                                </Grid>
                                <TextBlock Text="Ajustes" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                            </StackPanel>
                        </RadioButton>
                        
                    </StackPanel>
                </ScrollViewer>
                
                <!-- ══ FOOTER — Perfil de usuario ══ -->
                <StackPanel Grid.Row="2" Margin="10,0,10,10">
                    <!-- Tarjeta de perfil -->
                    <Border Padding="12,10" CornerRadius="10" Margin="0,0,0,6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0D2137" Offset="0"/>
                                <GradientStop Color="#132D52" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar con iniciales -->
                            <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1976D2" Offset="0"/>
                                        <GradientStop Color="#26A69A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding InicialesUsuario}" 
                                           FontSize="13" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Nombre y rol -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario}" 
                                           FontSize="12" Foreground="#D0DCE8" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Distribuidor" FontSize="9" Foreground="#4A6485" Margin="0,1,0,0"/>
                            </StackPanel>
                            <!-- Botón editar nombre -->
                            <Button Grid.Column="2" Command="{Binding EditarNombreCommand}"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Padding="4">
                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                      Fill="#4A6485" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Sección activa -->
                    <Border Padding="12,8" CornerRadius="8">
                        <Border.Background>
                            <SolidColorBrush Color="#0A1832"/>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Background="#4CAF50"/>
                            <TextBlock Grid.Column="1" Text="{Binding MenuSeleccionado}" 
                                       FontSize="11" Foreground="#5C7AA7" FontWeight="Medium"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ========== ÁREA DE CONTENIDO ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Contenido dinámico (Views) con transición -->
            <Border Grid.Row="0" ClipToBounds="True">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
            
            <!-- Barra de estado moderna -->
            <Border Grid.Row="1" Padding="16,8"
                    BorderThickness="0,1,0,0" BorderBrush="#E8E8E8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FAFBFC" Offset="0"/>
                        <GradientStop Color="#F0F4F8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#4CAF50" 
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="11" Foreground="#78909C" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Ryum Control" FontSize="10" Foreground="#B0BEC5" 
                                   FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Background="#ECEFF1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy'}"
                                       xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                       FontSize="10" Foreground="#78909C"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ========== OVERLAY — Configurar Nombre ========== -->
        <Border Grid.ColumnSpan="2" Background="#99000000"
                Visibility="{Binding MostrarConfigNombre, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="16" Width="420" Padding="32,28"
                    Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="4" Opacity="0.25" Color="#0D1B3E"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Icono de bienvenida -->
                    <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1976D2" Offset="0"/>
                                <GradientStop Color="#26A69A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                              Fill="White" Stretch="Uniform" Width="28" Height="28"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="¡Bienvenido a Ryum Control!" 
                               FontSize="18" FontWeight="Bold" Foreground="#1A237E"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Ingresa tu nombre para personalizar la aplicación" 
                               FontSize="12" Foreground="#78909C"
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <!-- Campo de nombre -->
                    <TextBlock Text="Nombre del distribuidor" FontSize="11" Foreground="#546E7A" 
                               FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1.5"
                            Background="#FAFBFC" Padding="12,10" Margin="0,0,0,20">
                        <TextBox Text="{Binding FormNombreUsuario, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="14" Foreground="#37474F"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Botón guardar -->
                    <Button Command="{Binding GuardarNombreCommand}"
                            HorizontalAlignment="Stretch" Cursor="Hand"
                            Padding="0,12" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1976D2" Offset="0"/>
                                            <GradientStop Color="#26A69A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Continuar" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

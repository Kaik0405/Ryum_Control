<Window x:Class="GestionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionApp"
        xmlns:vm="clr-namespace:GestionApp.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Titulo}" 
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Contenido principal -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- ========== SIDEBAR ========== -->
        <Border Grid.Column="0" Background="#1A237E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo / Título -->
                <Border Grid.Row="0" Padding="20" Background="#151D6B">
                    <StackPanel>
                        <TextBlock Text="💼" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sistema de Gestión" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="v1.0" 
                                   FontSize="11" 
                                   Foreground="#9FA8DA" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Menú de navegación -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        
                        <!-- Dashboard -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="18" Width="30"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Separador -->
                        <Border Height="1" Background="#3949AB" Margin="15,15,15,10"/>
                        <TextBlock Text="GESTIÓN" 
                                   FontSize="11" 
                                   Foreground="#7986CB" 
                                   Margin="20,0,0,10"
                                   FontWeight="SemiBold"/>
                        
                        <!-- Inventario -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToInventarioCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="18" Width="30"/>
                                <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Combos -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToCombosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎁" FontSize="18" Width="30"/>
                                <TextBlock Text="Combos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Entregas -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToEntregasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="18" Width="30"/>
                                <TextBlock Text="Entregas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Fichas de Costo -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToFichasCostoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="18" Width="30"/>
                                <TextBlock Text="Fichas de Costo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Separador -->
                        <Border Height="1" Background="#3949AB" Margin="15,15,15,10"/>
                        <TextBlock Text="FINANZAS" 
                                   FontSize="11" 
                                   Foreground="#7986CB" 
                                   Margin="20,0,0,10"
                                   FontWeight="SemiBold"/>
                        
                        <!-- Movimientos -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToMovimientosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💵" FontSize="18" Width="30"/>
                                <TextBlock Text="Movimientos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- Reportes -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Command="{Binding NavigateToReportesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="18" Width="30"/>
                                <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Información del usuario / Estado -->
                <Border Grid.Row="2" Padding="15" Background="#151D6B">
                    <StackPanel>
                        <TextBlock Text="{Binding MenuSeleccionado, StringFormat='📍 {0}'}" 
                                   FontSize="12" 
                                   Foreground="#B0BEC5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- ========== ÁREA DE CONTENIDO ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Contenido dinámico (Views) -->
            <ContentControl Grid.Row="0" 
                            Content="{Binding CurrentViewModel}"/>
            
            <!-- Barra de estado -->
            <Border Grid.Row="1" 
                    Background="#ECEFF1" 
                    Padding="15,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#E0E0E0">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" 
                               FontSize="12" 
                               Foreground="#666"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy'}"
                               xmlns:sys="clr-namespace:System;assembly=mscorlib"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#999"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

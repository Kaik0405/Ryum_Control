<UserControl x:Class="GestionApp.Views.EntregasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EntregasViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
        <h:EntregaEstadoConverter x:Key="EstadoColor"/>
        <h:EntregaEstadoTextoConverter x:Key="EstadoTexto"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ═══ FILA 0: ENCABEZADO ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="📦 Entregas" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#1A237E"/>
                <TextBlock Text="Órdenes de entrega de combos — plazo de 5 días" 
                           FontSize="14" 
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding CrearEntregaCommand}"
                    Background="#1565C0" 
                    Foreground="White"
                    Padding="20,10"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="➕ Nueva Entrega" Foreground="White" FontWeight="SemiBold"/>
            </Button>
        </Grid>

        <!-- ═══ FILA 1: CONTADORES DE ESTADO ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pendientes -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="⏳ Pendientes" FontSize="13" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalPendientes}" FontSize="28" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>
            </Border>

            <!-- Urgentes -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="🟠 Urgentes" FontSize="13" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalUrgentes}" FontSize="28" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
            </Border>

            <!-- Vencidas -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="🔴 Vencidas" FontSize="13" Foreground="#666"/>
                    <TextBlock Text="{Binding TotalVencidas}" FontSize="28" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ FILA 2: FILTROS ═══ -->
        <Border Grid.Row="2" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,15"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda por texto -->
                <TextBox Grid.Column="0" 
                         Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,8"
                         FontSize="13"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="#333"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Filtro por estado -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding OpcionesEstado}"
                          SelectedItem="{Binding FiltroEstado}"
                          Padding="10,8"
                          FontSize="13"
                          Margin="10,0,0,0"
                          Width="150"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"/>

                <!-- Botón refrescar -->
                <Button Grid.Column="2"
                        Command="{Binding RefrescarCommand}"
                        Content="🔄"
                        FontSize="16"
                        Padding="10,6"
                        Margin="10,0,0,0"
                        Background="Transparent"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- ═══ FILA 3: CONTENIDO PRINCIPAL ═══ -->
        <Grid Grid.Row="3">
            <!-- LISTA DE ENTREGAS (visible cuando no hay formulario ni detalle) -->
            <Border Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource InvBoolToVis}}">
                <Grid>
                    <!-- Mostrar detalle si hay uno seleccionado -->
                    <Grid Visibility="{Binding MostrarDetalle, Converter={StaticResource BoolToVis}}">
                        <Border Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding EntregaDetalle}">
                                    <!-- Botón cerrar -->
                                    <DockPanel Margin="0,0,0,15">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DataContext.CerrarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="✖ Cerrar"
                                                Padding="12,6"
                                                Background="#EF5350"
                                                Foreground="White"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Text="{Binding NumeroOrden, StringFormat='📋 Detalle: {0}'}" 
                                                   FontSize="22" FontWeight="Bold" Foreground="#1A237E"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Estado -->
                                    <Border Background="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=bg}"
                                            CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Converter={StaticResource EstadoTexto}}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"/>
                                    </Border>

                                    <!-- Info en 2 columnas -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Combo" FontSize="12" Foreground="#999" Margin="0,8,0,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fecha de Orden" FontSize="12" Foreground="#999" Margin="0,8,0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Combo.Nombre, StringFormat='#{0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Receptor" FontSize="12" Foreground="#999" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Fecha Límite" FontSize="12" Foreground="#999" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding NombreReceptor}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FechaLimite, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Dirección" FontSize="12" Foreground="#999" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Remitente" FontSize="12" Foreground="#999" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding DireccionReceptor}" FontSize="14" Foreground="#333" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NombreRemitente}" FontSize="14" Foreground="#333"/>
                                    </Grid>

                                    <!-- Teléfonos y Agencia -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📱 Móvil" FontSize="12" Foreground="#999" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TelefonoMovil}" FontSize="14" Foreground="#333"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="📞 Fijo" FontSize="12" Foreground="#999" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TelefonoFijo}" FontSize="14" Foreground="#333"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="🏢 Agencia" FontSize="12" Foreground="#999" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Agencia}" FontSize="14" Foreground="#333"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Productos -->
                                    <TextBlock Text="Productos del combo" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#1A237E" Margin="0,10,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Productos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding NombreProducto}" FontSize="13" Foreground="#333"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Descripcion, Mode=OneWay}" FontSize="13" Foreground="#666" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Observaciones -->
                                    <TextBlock Text="Observaciones" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#1A237E" Margin="0,15,0,4"/>
                                    <TextBlock Text="{Binding Observaciones, TargetNullValue='Sin observaciones'}" 
                                               FontSize="13" Foreground="#666" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- DataGrid (visible cuando no hay detalle) -->
                    <DataGrid Visibility="{Binding MostrarDetalle, Converter={StaticResource InvBoolToVis}}"
                              ItemsSource="{Binding EntregasFiltradas}"
                              SelectedItem="{Binding EntregaSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0"
                              BorderThickness="0"
                              Background="White"
                              RowHeaderWidth="0"
                              CanUserResizeRows="False"
                              FontSize="13">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FAFAFA"/>
                                <Setter Property="Foreground" Value="#666"/>
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Estado (indicador de color) -->
                            <DataGridTemplateColumn Header="" Width="8" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="8" CornerRadius="4"
                                                Background="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"
                                                Margin="-10,-8,0,-8"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Número Orden -->
                            <DataGridTextColumn Header="Orden" Binding="{Binding NumeroOrden}" Width="110"/>

                            <!-- Combo -->
                            <DataGridTemplateColumn Header="Combo" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="#"/><Run Text="{Binding Combo.Numero, Mode=OneWay}"/>
                                            <Run Text=" — "/><Run Text="{Binding Combo.Nombre, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Receptor -->
                            <DataGridTextColumn Header="Receptor" Binding="{Binding NombreReceptor}" Width="*"/>

                            <!-- Remitente -->
                            <DataGridTextColumn Header="Remitente" Binding="{Binding NombreRemitente}" Width="120"/>

                            <!-- Fecha Orden -->
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yy}'}" Width="80"/>

                            <!-- Estado con texto -->
                            <DataGridTemplateColumn Header="Estado" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EstadoTexto}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="Acciones" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Ver detalle -->
                                            <Button Content="👁" ToolTip="Ver detalle"
                                                    Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" Margin="0,0,4,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>

                                            <!-- Marcar entregada -->
                                            <Button Content="✅" ToolTip="Marcar como entregada"
                                                    Command="{Binding DataContext.MarcarEntregadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" Margin="0,0,4,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>

                                            <!-- Editar -->
                                            <Button Content="✏️" ToolTip="Editar"
                                                    Command="{Binding DataContext.EditarEntregaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" Margin="0,0,4,0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>

                                            <!-- Eliminar -->
                                            <Button Content="🗑" ToolTip="Eliminar"
                                                    Command="{Binding DataContext.EliminarEntregaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="14"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ FORMULARIO (visible cuando MostrarFormulario = true) ═══ -->
            <Border Style="{StaticResource CardStyle}" Padding="25"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="650" HorizontalAlignment="Left">

                        <!-- Título del formulario -->
                        <TextBlock Text="{Binding TituloFormulario}" 
                                   FontSize="22" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,20"/>

                        <!-- Combo -->
                        <TextBlock Text="Combo *" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CombosDisponibles}"
                                  SelectedItem="{Binding FormComboSeleccionado}"
                                  Padding="10,8"
                                  FontSize="13"
                                  BorderBrush="#E0E0E0"
                                  Margin="0,0,0,15">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="#"/><Run Text="{Binding Numero, Mode=OneWay}"/>
                                        <Run Text=" — "/><Run Text="{Binding Nombre, Mode=OneWay}"/>
                                        <Run Text=" ("/><Run Text="{Binding Tipo, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Fecha de Orden -->
                        <TextBlock Text="Fecha de Orden (automática, editable)" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FormFechaOrden}"
                                    Padding="8,6"
                                    FontSize="13"
                                    BorderBrush="#E0E0E0"
                                    Margin="0,0,0,15"/>

                        <!-- Separador: Receptor -->
                        <Border Height="1" Background="#E0E0E0" Margin="0,5,0,15"/>
                        <TextBlock Text="DATOS DEL RECEPTOR" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#1565C0" Margin="0,0,0,12"/>

                        <!-- Nombre Receptor -->
                        <TextBlock Text="Nombre del Receptor *" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormReceptor, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" BorderBrush="#E0E0E0" Margin="0,0,0,12"/>

                        <!-- Dirección -->
                        <TextBlock Text="Dirección" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormDireccion, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" BorderBrush="#E0E0E0" Margin="0,0,0,12"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"/>

                        <!-- Teléfonos en fila -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📱 Teléfono Móvil" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormTelefonoMovil, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" FontSize="13" BorderBrush="#E0E0E0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📞 Teléfono Fijo" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FormTelefonoFijo, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8" FontSize="13" BorderBrush="#E0E0E0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Separador: Envío -->
                        <Border Height="1" Background="#E0E0E0" Margin="0,10,0,15"/>
                        <TextBlock Text="DATOS DEL ENVÍO" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#1565C0" Margin="0,0,0,12"/>

                        <!-- Remitente -->
                        <TextBlock Text="Nombre de quien envía *" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormRemitente, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" BorderBrush="#E0E0E0" Margin="0,0,0,12"/>

                        <!-- Agencia -->
                        <TextBlock Text="Agencia" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormAgencia, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" BorderBrush="#E0E0E0" Margin="0,0,0,12"/>

                        <!-- Observaciones -->
                        <TextBlock Text="Observaciones" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FormObservaciones, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,8" FontSize="13" BorderBrush="#E0E0E0" Margin="0,0,0,20"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>

                        <!-- Botones del formulario -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CancelarCommand}"
                                    Padding="18,10"
                                    FontSize="13"
                                    Background="#EEEEEE"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="Cancelar" Foreground="#666"/>
                            </Button>

                            <Button Command="{Binding GuardarCommand}"
                                    Padding="25,10"
                                    FontSize="13"
                                    Background="#1565C0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#B0BEC5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="💾 Guardar Entrega" Foreground="White" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ FILA 4: BARRA DE ESTADO ═══ -->
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="10,8" Background="#ECEFF1" CornerRadius="6">
            <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="#666"/>
        </Border>
    </Grid>
</UserControl>

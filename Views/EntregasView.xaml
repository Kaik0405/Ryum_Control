<UserControl x:Class="GestionApp.Views.EntregasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EntregasViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
        <h:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <h:EntregaEstadoConverter x:Key="EstadoColor"/>
        <h:EntregaEstadoTextoConverter x:Key="EstadoTexto"/>
    </UserControl.Resources>
    
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ═══ FILA 0: ENCABEZADO + CONTADORES COMPACTOS ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titulo -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Entregas" FontSize="22" FontWeight="Bold" Foreground="#142F49"/>
                    <TextBlock Text="Ordenes de entrega de combos" FontSize="11" Foreground="#657C91" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Contadores inline -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Pendientes -->
                    <Border Background="#EAF1F7" CornerRadius="8" Padding="14,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#173F63" CornerRadius="10" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalPendientes}" FontSize="12" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Pendientes" FontSize="11" Foreground="#173F63" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Urgentes -->
                    <Border Background="#FFF4D6" CornerRadius="8" Padding="14,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#9B7100" CornerRadius="10" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalUrgentes}" FontSize="12" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Urgentes" FontSize="11" Foreground="#9B7100" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Vencidas -->
                    <Border Background="#FCECEF" CornerRadius="8" Padding="14,6" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#B74756" CornerRadius="10" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalVencidas}" FontSize="12" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Vencidas" FontSize="11" Foreground="#B74756" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Entregadas -->
                    <Border Background="#E8F4EC" CornerRadius="8" Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#287A56" CornerRadius="10" Width="24" Height="24" Margin="0,0,8,0">
                                <TextBlock Text="{Binding TotalEntregadas}" FontSize="12" FontWeight="Bold" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Entregadas" FontSize="11" Foreground="#287A56" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botones Nueva Entrega / Nueva Remesa -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CrearRemesaCommand}" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#287A56" CornerRadius="8" Padding="16,8">
                                    <TextBlock Text="💵 Nueva Remesa" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1B5E20"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Command="{Binding CrearEntregaCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#173F63" CornerRadius="8" Padding="16,8">
                                    <TextBlock Text="+ Nueva Entrega" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2A638F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FILA 1: FILTROS — Diseño cápsula ═══ -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,8"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Búsqueda por texto (cápsula con icono) -->
                <Border Grid.Column="0" Background="#F9FBFD" CornerRadius="10" Padding="4,0"
                        BorderBrush="#D1DDE8" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E9F0F6" CornerRadius="8" 
                                Width="30" Height="30" Margin="2,3,0,3" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,7" FontSize="12" BorderThickness="0" Background="Transparent"
                                 Foreground="#203B54" VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar por orden, receptor, combo..." 
                                                                       Foreground="#657C91" Margin="10,0,0,0" FontSize="12"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Filtro por estado (cápsula) -->
                <Border Grid.Column="2" Background="#F2F6FA" CornerRadius="10" Padding="10,4"
                        BorderBrush="#D1DDE8" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Estado" FontSize="11" Foreground="#657C91" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding OpcionesEstado}"
                                  SelectedItem="{Binding FiltroEstado}"
                                  Padding="4,2" FontSize="12" Width="120"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón actualizar (cápsula) -->
                <Button Grid.Column="4" Command="{Binding RefrescarCommand}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,6"
                                    BorderBrush="#D1DDE8" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Actualizar" FontSize="12" FontWeight="SemiBold" Foreground="#465E75" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ FILA 2: CONTENIDO PRINCIPAL ═══ -->
        <Grid Grid.Row="2">
            <!-- LISTA DE ENTREGAS (visible cuando no hay formulario ni detalle) -->
            <Border Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource InvBoolToVis}}">
                <Grid>
                    <!-- Mostrar detalle si hay uno seleccionado -->
                    <Grid Visibility="{Binding MostrarDetalle, Converter={StaticResource BoolToVis}}">
                        <Border Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding EntregaDetalle}">
                                    <!-- Botón cerrar -->
                                    <DockPanel Margin="0,0,0,15">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding DataContext.CerrarDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Content="✖ Cerrar"
                                                Padding="12,6"
                                                Background="#EF5350"
                                                Foreground="White"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#B74756"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Text="{Binding NumeroOrden, StringFormat='📋 Detalle: {0}'}" 
                                                   FontSize="22" FontWeight="Bold" Foreground="#142F49"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Estado -->
                                    <Border Background="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=bg}"
                                            CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Converter={StaticResource EstadoTexto}}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"/>
                                    </Border>

                                    <!-- Info en 2 columnas -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Combo" FontSize="12" Foreground="#657C91" Margin="0,8,0,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Fecha de Orden" FontSize="12" Foreground="#657C91" Margin="0,8,0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontWeight="SemiBold" Foreground="#203B54">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Combo.Nombre, StringFormat='#{0}'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                            <Setter Property="Text" Value="{Binding MontoRemesa, StringFormat='💵 Remesa {0:N0} CUP'}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="14" FontWeight="SemiBold" Foreground="#203B54"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Receptor" FontSize="12" Foreground="#657C91" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Fecha Límite" FontSize="12" Foreground="#657C91" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding NombreReceptor}" FontSize="14" FontWeight="SemiBold" Foreground="#203B54"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FechaLimite, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="14" FontWeight="SemiBold" Foreground="#203B54"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Dirección" FontSize="12" Foreground="#657C91" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Remitente" FontSize="12" Foreground="#657C91" Margin="0,12,0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding DireccionCompleta}" FontSize="14" Foreground="#203B54" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NombreRemitente}" FontSize="14" Foreground="#203B54"/>
                                    </Grid>

                                    <!-- Teléfonos y Agencia -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📱 Móvil" FontSize="12" Foreground="#657C91" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TelefonoMovil}" FontSize="14" Foreground="#203B54"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="📞 Fijo" FontSize="12" Foreground="#657C91" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TelefonoFijo}" FontSize="14" Foreground="#203B54"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="🏢 Agencia" FontSize="12" Foreground="#657C91" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Agencia, Converter={StaticResource AgenciaLogo}}"
                                                       Width="18" Height="18" Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Agencia}" FontSize="14" Foreground="#203B54" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Productos del combo con disponibilidad -->
                                    <TextBlock Text="Productos del combo" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#142F49" Margin="0,10,0,4"/>

                                    <!-- Banner de disponibilidad general -->
                                    <Border Visibility="{Binding DataContext.MostrarDisponibilidad, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                            BorderBrush="#D1DDE8" BorderThickness="1" Background="#F7FAFC">
                                        <TextBlock Text="{Binding DataContext.DisponibilidadGeneral, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Lista con disponibilidad por producto -->
                                    <ItemsControl ItemsSource="{Binding DataContext.ProductosDisponibilidad, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#D1DDE8" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Icono de estado -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="13" 
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <!-- Nombre producto -->
                                                        <TextBlock Grid.Column="1" Text="{Binding NombreProducto}" 
                                                                   FontSize="13" Foreground="#203B54" VerticalAlignment="Center"/>
                                                        <!-- Cantidad requerida -->
                                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="#536A80" 
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0">
                                                            <Run Text="{Binding CantidadRequerida, StringFormat='{}{0:G}', Mode=OneWay}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding Unidad, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <!-- Chip de estado -->
                                                        <Border Grid.Column="3" Background="{Binding ColorFondo}" 
                                                                CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Estado}" FontSize="10" 
                                                                       Foreground="{Binding ColorTexto}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Observaciones -->
                                    <TextBlock Text="Observaciones" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="#142F49" Margin="0,15,0,4"/>
                                    <TextBlock Text="{Binding Observaciones, TargetNullValue='Sin observaciones'}" 
                                               FontSize="13" Foreground="#536A80" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- DataGrid (visible cuando no hay detalle) -->
                    <DataGrid Visibility="{Binding MostrarDetalle, Converter={StaticResource InvBoolToVis}}"
                              ItemsSource="{Binding EntregasFiltradas}"
                              SelectedItem="{Binding EntregaSeleccionada}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#DFE7EF"
                              BorderThickness="0"
                              Background="#FFFFFF"
                              RowHeaderWidth="0"
                              CanUserResizeRows="False"
                              FontSize="13">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F6FA"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF1F7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#203B54"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F7FAFC"/>
                                <Setter Property="Foreground" Value="#536A80"/>
                                <Setter Property="Padding" Value="10,10"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#D1DDE8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Estado (indicador de color) -->
                            <DataGridTemplateColumn Header="" Width="8" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="8" CornerRadius="4"
                                                Background="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"
                                                Margin="-10,-8,0,-8"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Número Orden -->
                            <DataGridTextColumn Header="Orden" Binding="{Binding NumeroOrden}" Width="110"/>

                            <!-- Combo / Remesa -->
                            <DataGridTemplateColumn Header="Tipo" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                            <Setter Property="Foreground" Value="#287A56"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EsRemesa}" Value="False">
                                                            <Setter Property="Foreground" Value="#203B54"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}">
                                                    <Binding Path="Resumen"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Receptor -->
                            <DataGridTextColumn Header="Receptor" Binding="{Binding NombreReceptor}" Width="*"/>

                            <!-- Dirección (Municipio, Provincia) -->
                            <DataGridTextColumn Header="Dirección" Binding="{Binding DireccionResumida}" Width="160"/>

                            <!-- Remitente -->
                            <DataGridTextColumn Header="Remitente" Binding="{Binding NombreRemitente}" Width="120"/>

                            <!-- Fecha Orden -->
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yy}'}" Width="80"/>

                            <!-- Estado con texto -->
                            <DataGridTemplateColumn Header="Estado" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EstadoTexto}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource EstadoColor}, ConverterParameter=fg}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones -->
                            <DataGridTemplateColumn Header="Acciones" Width="340">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Ver detalle -->
                                            <Button ToolTip="Ver detalle" Cursor="Hand"
                                                    Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#EAF1F7" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                                                            <TextBlock Text="Ver" FontSize="11" FontWeight="SemiBold" Foreground="#173F63"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#DDE8F2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Marcar entregada -->
                                            <Button Cursor="Hand"
                                                    Command="{Binding DataContext.MarcarEntregadaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding Entregada, Converter={StaticResource InverseBoolConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="ToolTip" Value="Marcar como entregada"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                                <Setter Property="ToolTip" Value="Enviar remesa y registrar en Finanzas"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Entregada}" Value="True">
                                                                <Setter Property="ToolTip" Value="Ya fue entregada"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#E8F4EC"/>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock x:Name="txt" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Entregar"/>
                                                                        <Setter Property="Foreground" Value="#287A56"/>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#CBE6D4"/>
                                                            </Trigger>
                                                            <!-- Remesa pendiente: mismo botón verde -->
                                                            <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                                <Setter TargetName="txt" Property="Text" Value="Entregar"/>
                                                            </DataTrigger>
                                                            <!-- Ya entregada: gris deshabilitado -->
                                                            <DataTrigger Binding="{Binding Entregada}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                                                <Setter TargetName="txt" Property="Text" Value="✅ Entregada"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="#73879B"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Modelo conformidad -->
                                            <Button ToolTip="Modelo de conformidad" Cursor="Hand"
                                                    Command="{Binding DataContext.GenerarConformidadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#EAF1F7" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                                                            <TextBlock Text="Conformidad" FontSize="11" FontWeight="SemiBold" Foreground="#173F63"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#EAF1F7"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Separador -->
                                            <Border Width="1" Background="#D1DDE8" Margin="2,4" VerticalAlignment="Stretch"/>

                                            <!-- Editar -->
                                            <Button ToolTip="Editar" Cursor="Hand"
                                                    Command="{Binding DataContext.EditarEntregaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#173F63" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                                                            <TextBlock Text="Editar" FontSize="11" FontWeight="SemiBold" Foreground="#244B6A"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#425B87"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Eliminar -->
                                            <Button ToolTip="Eliminar" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarEntregaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#FCECEF" CornerRadius="6" Padding="8,4" Margin="0,0,0,0">
                                                            <TextBlock Text="Eliminar" FontSize="11" FontWeight="SemiBold" Foreground="#B74756"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#F8D8DD"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ MODELO DE CONFORMIDAD ═══ -->
            <Border Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding MostrarConformidad, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FFFFFF" Padding="20,14" CornerRadius="8,8,0,0"
                            BorderBrush="#E9F0F6" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" CornerRadius="2" Background="#173F63" Margin="0,2,12,2"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Modelo de Conformidad" 
                                               FontSize="17" FontWeight="Bold" Foreground="#153C5D"/>
                                    <TextBlock Text="Vista previa del documento — listo para exportar o imprimir" 
                                               FontSize="11" Foreground="#73879B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CerrarConformidadCommand}" Cursor="Hand"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FCECEF" CornerRadius="14" 
                                                Width="28" Height="28">
                                            <TextBlock Text="X" FontSize="13" Foreground="#D32F2F" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F8D8DD"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Cuerpo: Vista previa del modelo -->
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="20,10">
                        <Border x:Name="ConformidadPanel" 
                                Background="White" CornerRadius="0" Padding="0"
                                Width="650"
                                BorderBrush="#D1DDE8" BorderThickness="1">
                            <!-- Hoja tipo documento -->
                            <Grid DataContext="{Binding EntregaConformidad}" Margin="40,30" Background="White">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Titulo + Logo agencia -->
                                <Grid Grid.Row="0" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Center" Grid.ColumnSpan="2">
                                        <TextBlock Text="MODELO DE CONFORMIDAD" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#142F49"
                                                   HorizontalAlignment="Center"/>
                                        <Border Background="#173F63" Height="2" Margin="0,5,0,0" CornerRadius="1"/>
                                    </StackPanel>
                                    <!-- Logo de la agencia arriba a la derecha -->
                                    <Image Grid.Column="1" 
                                           Source="{Binding Agencia, Converter={StaticResource AgenciaLogo}}"
                                           MaxHeight="50" MaxWidth="120"
                                           VerticalAlignment="Top" HorizontalAlignment="Right"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="10,0,0,0"/>
                                </Grid>

                                <!-- Fechas -->
                                <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tipo de Pedido" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#203B54">
                                                <Run Text="Combo #"/><Run Text="{Binding Combo.Numero, Mode=OneWay}"/>
                                                <Run Text=" - "/><Run Text="{Binding Combo.Nombre, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="Fecha de Envio" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yyyy}'}" FontSize="12" FontWeight="Bold" Foreground="#203B54"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="Fecha de Entrega" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FechaOrden, Converter={StaticResource FechaMasUnDia}}" FontSize="12" FontWeight="Bold" Foreground="#203B54"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Seccion: Quien envia -->
                                <Border Grid.Row="2" Background="White" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="REMITENTE (Quien envia)" FontSize="10" FontWeight="Bold" Foreground="#173F63"/>
                                </Border>
                                <Border Grid.Row="3" Padding="8,4" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding NombreRemitente}" FontSize="12" Foreground="#203B54"/>
                                </Border>

                                <!-- Seccion: Quien recibe -->
                                <Border Grid.Row="4" Background="White" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                    <TextBlock Text="RECEPTOR (Quien recibe)" FontSize="10" FontWeight="Bold" Foreground="#287A56"/>
                                </Border>
                                <Grid Grid.Row="5" Margin="8,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                                        <TextBlock Text="Nombre" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding NombreReceptor}" FontSize="12" Foreground="#203B54"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                                        <TextBlock Text="Telefono" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                        <TextBlock FontSize="12" Foreground="#203B54">
                                            <Run Text="{Binding TelefonoMovil, Mode=OneWay}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding TelefonoFijo, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                        <TextBlock Text="Direccion" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DireccionCompleta}" FontSize="12" Foreground="#203B54" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Productos entregados (solo para combos) -->
                                <Border Grid.Row="6" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF4D6"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                    <Setter Property="Background" Value="#E8F4EC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="PRODUCTOS ENTREGADOS"/>
                                                <Setter Property="Foreground" Value="#9B7100"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                        <Setter Property="Text" Value="💵 REMESA"/>
                                                        <Setter Property="Foreground" Value="#287A56"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Lista de productos (visible solo si NO es remesa) -->
                                <ItemsControl Grid.Row="7" ItemsSource="{Binding Productos}" Margin="0,0,0,12">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DFE7EF" BorderThickness="0,0,0,1" Padding="8,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding NombreProducto}" 
                                                               FontSize="12" Foreground="#203B54" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#536A80" FontWeight="SemiBold">
                                                        <Run Text="{Binding Cantidad, StringFormat='{}{0:G}', Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Unidad, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Panel monto remesa (visible solo si ES remesa) -->
                                <Border Grid.Row="7" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                                        Background="White" BorderBrush="#34775A" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Monto de la remesa" FontSize="10" Foreground="#558B2F" 
                                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#287A56" 
                                                   HorizontalAlignment="Center">
                                            <Run Text="{Binding MontoRemesa, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                            <Run Text=" CUP"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Agencia y firmas -->
                                <Grid Grid.Row="8" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Agencia" FontSize="9" Foreground="#657C91" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Image Source="{Binding Agencia, Converter={StaticResource AgenciaLogo}}"
                                                   Width="16" Height="16" Margin="0,0,5,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Agencia}" FontSize="12" Foreground="#203B54" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Distribuidor -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <TextBlock FontSize="11" Foreground="#203B54">
                                            <Run Text="Distribuidor: " FontWeight="Bold"/>
                                            <Run Text="{Binding DataContext.NombreDistribuidor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Espacio para firma -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,15,20,0">
                                        <Border BorderBrush="#203B54" BorderThickness="0,0,0,1" Height="40"/>
                                        <TextBlock Text="Firma del receptor" FontSize="9" Foreground="#657C91" 
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="20,15,0,0">
                                        <Border BorderBrush="#203B54" BorderThickness="0,0,0,1" Height="40"/>
                                        <TextBlock Text="Firma del distribuidor" FontSize="9" Foreground="#657C91" 
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Viewbox>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" Background="#FFFFFF" Padding="15" CornerRadius="0,0,8,8"
                            BorderBrush="#E9F0F6" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Guardar como imagen -->
                            <Button x:Name="BtnExportarImagen" Cursor="Hand" Margin="0,0,10,0"
                                    Click="ExportarConformidadImagen_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#173F63" CornerRadius="6" Padding="20,10">
                                            <TextBlock Text="Guardar como Imagen" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#285B80"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Imprimir -->
                            <Button x:Name="BtnImprimirConformidad" Cursor="Hand" Margin="0,0,10,0"
                                    Click="ImprimirConformidad_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#173F63" CornerRadius="6" Padding="20,10">
                                            <TextBlock Text="Imprimir" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#2A638F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Cancelar -->
                            <Button Command="{Binding CerrarConformidadCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="6" Padding="20,10"
                                                BorderBrush="#D1DDE8" BorderThickness="1">
                                            <TextBlock Text="Cancelar" Foreground="#536A80" FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ FORMULARIO NUEVA/EDITAR ENTREGA ═══ -->
            <Border Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}">
                <Grid Width="820" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── ENCABEZADO ── -->
                    <Border Grid.Row="0" Background="#FFFFFF" Padding="20,14" CornerRadius="8,8,0,0"
                            BorderBrush="#E9F0F6" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="4" CornerRadius="2" Background="#173F63" Margin="0,2,12,2"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TituloFormulario}" 
                                               FontSize="17" FontWeight="Bold" Foreground="#142F49"/>
                                    <TextBlock Text="Complete los campos requeridos (*) para registrar la entrega" 
                                               FontSize="11" Foreground="#73879B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── CUERPO ── -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <Grid Margin="20,12,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ROW 0: Headers de sección -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#EAF1F7" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                            <TextBlock Text="📦 Datos del envío" FontSize="11" FontWeight="Bold" Foreground="#173F63"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#E8F4EC" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                            <TextBlock Text="👤 Datos del receptor" FontSize="11" FontWeight="Bold" Foreground="#287A56"/>
                        </Border>

                        <!-- ROW 1: Combo/Remesa | Nombre Receptor -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <!-- Combo selector (visible cuando NO es remesa) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="COMBO *" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding CombosDisponibles}"
                                          SelectedItem="{Binding FormComboSeleccionado}"
                                          Padding="8,6" FontSize="12" BorderBrush="#D1DDE8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12">
                                                <Run Text="#"/><Run Text="{Binding Numero, Mode=OneWay}"/>
                                                <Run Text=" — "/><Run Text="{Binding Nombre, Mode=OneWay}"/>
                                                <Run Text=" ("/><Run Text="{Binding Tipo, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Panel de disponibilidad debajo del combo selector -->
                                <Border Visibility="{Binding MostrarDisponibilidad, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="6" Padding="8,6" Margin="0,6,0,0"
                                        BorderBrush="#D1DDE8" BorderThickness="1" Background="#F7FAFC">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisponibilidadGeneral}" 
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding ProductosDisponibilidad}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,1" Padding="6,3" CornerRadius="4"
                                                            Background="{Binding ColorFondo}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="10" 
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding NombreProducto}" FontSize="10"
                                                                       Foreground="{Binding ColorTexto}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detalle}" FontSize="9"
                                                                       Foreground="{Binding ColorTexto}" VerticalAlignment="Center"
                                                                       FontStyle="Italic"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Monto remesa (visible cuando ES remesa) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsRemesa}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="MONTO DE LA REMESA (CUP) *" FontSize="10" Foreground="#287A56" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding FormMontoRemesa, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         Padding="10,8" FontSize="16" FontWeight="Bold" BorderBrush="#287A56"
                                         Foreground="#287A56" Background="#EDF6F0"/>
                                <Border Background="#E8F4EC" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💵 REMESA" FontSize="12" FontWeight="Bold" Foreground="#287A56"/>
                                        <TextBlock Text="Envío de dinero — no se selecciona combo ni productos." 
                                                   FontSize="10" Foreground="#558B2F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="El monto se descontará del dinero en existencia al entregar (módulo Finanzas)." 
                                                   FontSize="10" Foreground="#558B2F" TextWrapping="Wrap" FontStyle="Italic"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="NOMBRE DEL RECEPTOR *" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormReceptor, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" BorderBrush="#D1DDE8">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Nombre completo..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- ROW 2: Fecha + Agencia | Dirección -->
                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FECHA DE ORDEN" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding FormFechaOrden}"
                                            Padding="8,5" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="AGENCIA" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AgenciasDisponibles}"
                                          SelectedItem="{Binding FormAgenciaSeleccionada}"
                                          Padding="6,4" FontSize="12" BorderBrush="#D1DDE8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Nombre, Converter={StaticResource AgenciaLogo}}"
                                                       Width="20" Height="20" Margin="0,0,6,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                            <!-- Provincia + Municipio -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROVINCIA" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding ProvinciasDisponibles}"
                                              SelectedItem="{Binding FormProvincia}"
                                              Padding="6,5" FontSize="12" BorderBrush="#D1DDE8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MUNICIPIO" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding MunicipiosDisponibles}"
                                              SelectedItem="{Binding FormMunicipio}"
                                              IsEnabled="{Binding FormProvincia.Length, FallbackValue=False}"
                                              Padding="6,5" FontSize="12" BorderBrush="#D1DDE8"/>
                                </StackPanel>
                            </Grid>
                            <!-- Localidad + Dirección Particular -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="LOCALIDAD" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding FormLocalidad, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,5" FontSize="12" BorderBrush="#D1DDE8">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="Reparto, zona..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DIRECCIÓN PARTICULAR" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding FormDireccionParticular, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,5" FontSize="12" BorderBrush="#D1DDE8">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="Calle, #, e/..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ROW 3: Segundo bloque headers -->
                        <Border Grid.Row="3" Grid.Column="0" Background="#FFF4D6" CornerRadius="6" Padding="8,4" Margin="0,2,0,8">
                            <TextBlock Text="✉️ Remitente" FontSize="11" FontWeight="Bold" Foreground="#9B7100"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" Background="#EAF1F7" CornerRadius="6" Padding="8,4" Margin="0,2,0,8">
                            <TextBlock Text="📞 Contacto" FontSize="11" FontWeight="Bold" Foreground="#173F63"/>
                        </Border>

                        <!-- ROW 4: Remitente | Teléfonos -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="NOMBRE DE QUIEN ENVÍA *" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormRemitente, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" BorderBrush="#D1DDE8">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Nombre completo..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                        <Grid Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📱 MÓVIL" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding FormTelefonoMovil, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12" BorderBrush="#D1DDE8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="+53 5..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="📞 FIJO" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding FormTelefonoFijo, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="12" BorderBrush="#D1DDE8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Ej: 7..." Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 5: Separador -->
                        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" 
                                BorderBrush="#E9F0F6" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- ROW 6: Observaciones (col izq) + Botones (col der) -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,0,0,0">
                            <TextBlock Text="📝 OBSERVACIONES" FontSize="10" Foreground="#657C91" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding FormObservaciones, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" BorderBrush="#D1DDE8"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="40">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Notas adicionales..." 
                                                                           Foreground="#73879B" Margin="10,0,0,0" FontSize="11"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- Botones alineados abajo a la derecha -->
                        <Grid Grid.Row="6" Grid.Column="2" 
                              VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding CancelarCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="8" Padding="16,10"
                                                BorderBrush="#B74756" BorderThickness="1.5">
                                            <TextBlock x:Name="txt" Text="Cancelar" Foreground="#B74756" 
                                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#B74756"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding GuardarCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="8" Padding="20,10"
                                                BorderBrush="#287A56" BorderThickness="1.5">
                                            <TextBlock x:Name="txt" Text="Guardar" Foreground="#287A56" 
                                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#287A56"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#73879B"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#73879B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ FILA 3: BARRA DE ESTADO ═══ -->
        <Border Grid.Row="3" Margin="0,6,0,0" Padding="12,8" Background="#142F49" CornerRadius="8">
            <Grid>
                <TextBlock Text="{Binding MensajeEstado}" FontSize="11" Foreground="#CBD8E5"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="ENTREGAS" FontSize="10" Foreground="#CBD8E5" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#244B6A" CornerRadius="6" Padding="10,3">
                        <TextBlock Text="{Binding EntregasFiltradas.Count}" FontSize="13" 
                                   Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

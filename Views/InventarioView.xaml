<UserControl x:Class="GestionApp.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InventarioViewModel}"
             d:DesignHeight="700" d:DesignWidth="950"
             Background="#F5F5F5">

    <!-- 
    CÓMO FUNCIONA ESTA VISTA:
    
    La vista se conecta al InventarioViewModel mediante "Bindings".
    Ejemplo: Text="{Binding Filtro}" conecta el TextBox a la propiedad Filtro del ViewModel.
    Cuando el usuario escribe, el ViewModel recibe el texto y filtra la lista.
    
    Los botones usan Command="{Binding NombreCommand}" para ejecutar acciones.
    -->

    <!-- Conversor para mostrar/ocultar el formulario -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Fila 0: Encabezado -->
            <RowDefinition Height="Auto"/>   <!-- Fila 1: Filtros -->
            <RowDefinition Height="*"/>      <!-- Fila 2: Contenido principal -->
            <RowDefinition Height="Auto"/>   <!-- Fila 3: Barra de estado -->
        </Grid.RowDefinitions>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 0: ENCABEZADO - Título y botón de acción -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="📦 Inventario" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#1A237E"/>
                <TextBlock Text="Gestión de productos y stock" 
                           FontSize="14" 
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Botón principal: abre el formulario de nuevo producto -->
            <Button Grid.Column="1" 
                    Command="{Binding NuevoProductoCommand}"
                    Background="#1976D2" 
                    Foreground="White"
                    Padding="20,10"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="➕ Nuevo Producto" Foreground="White" FontWeight="SemiBold"/>
            </Button>
        </Grid>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 1: BARRA DE FILTROS -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,15"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Buscador: cada letra que escribes filtra la lista en tiempo real -->
                <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8"
                         FontSize="13"
                         BorderBrush="#DDD"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Buscar producto por nombre, descripción o categoría..." 
                                                               Foreground="#999" 
                                                               Margin="12,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <CheckBox Grid.Column="1"
                          Content=" Solo en stock" 
                          IsChecked="{Binding MostrarSoloEnStock}"
                          Margin="15,0,15,0"
                          VerticalAlignment="Center"
                          FontSize="13"/>
                
                <!-- Botón refrescar -->
                <Button Grid.Column="2"
                        Command="{Binding RefrescarCommand}"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="#DDD"
                        Padding="10,6"
                        Cursor="Hand"
                        ToolTip="Recargar lista">
                    <TextBlock Text="🔄" FontSize="16"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 2: CONTENIDO PRINCIPAL (DataGrid + Formulario) -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>          <!-- Columna 0: Lista de productos -->
                <ColumnDefinition Width="Auto"/>       <!-- Columna 1: Formulario (aparece/desaparece) -->
            </Grid.ColumnDefinitions>
            
            <!-- ═══ LISTA DE PRODUCTOS (DataGrid) ═══ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,0">
                <DataGrid ItemsSource="{Binding ProductosFiltrados}" 
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="46"
                          FontSize="13"
                          SelectionMode="Single">
                    
                    <!-- Estilo de cabeceras -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <!-- Estilo de filas -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="46"/>
                            <Setter Property="Padding" Value="0,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <!-- COLUMNAS: cada una conectada a una propiedad del modelo Producto -->
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="120" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" 
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="320">
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Descripcion, TargetNullValue='Sin descripción'}" 
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#666" Margin="0,6,0,0"/>
                                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,8,0,4" Padding="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Stock: " FontSize="11" Foreground="#999"/>
                                                            <TextBlock Text="{Binding StockConUnidad}" FontSize="11" Foreground="#333" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  ·  Costo: " FontSize="11" Foreground="#999" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding CostoCompra, StringFormat=$ {0:N2}}" FontSize="11" Foreground="#333" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Unidad" 
                                            Binding="{Binding Unidad}" 
                                            Width="80"/>
                        
                        <DataGridTextColumn Header="Costo" 
                                            Binding="{Binding CostoCompra, StringFormat=$ {0:N2}}" 
                                            Width="100"/>
                        
                        <DataGridTextColumn Header="Stock" 
                                            Binding="{Binding StockConUnidad}" 
                                            Width="110"/>
                        
                        <DataGridTextColumn Header="Costo Total" 
                                            Binding="{Binding CostoTotal, StringFormat=$ {0:N2}}" 
                                            Width="120"/>
                        
                        <DataGridTextColumn Header="Ingreso" 
                                            Binding="{Binding FechaIngreso, StringFormat={}{0:dd/MM/yyyy}}" 
                                            Width="100"/>
                        
                        <!-- Columna de acciones: Stock +/−, Historial, Editar, Eliminar -->
                        <DataGridTemplateColumn Header="Acciones" Width="350">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Botón Agregar stock -->
                                        <Button ToolTip="Ingresar stock" Cursor="Hand"
                                                Command="{Binding DataContext.IngresarStockCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#E8F5E9" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Agregar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Botón Quitar stock -->
                                        <Button ToolTip="Dar salida" Cursor="Hand"
                                                Command="{Binding DataContext.SacarStockCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#FFF3E0" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Quitar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#E65100" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFE0B2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Separador -->
                                        <Border Width="1" Background="#E0E0E0" Margin="3,4" VerticalAlignment="Stretch"/>
                                        <!-- Botón Historial -->
                                        <Button ToolTip="Ver historial" Cursor="Hand"
                                                Command="{Binding DataContext.VerHistorialCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#E3F2FD" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Historial" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#1565C0" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Separador -->
                                        <Border Width="1" Background="#E0E0E0" Margin="3,4" VerticalAlignment="Stretch"/>
                                        <!-- Botón Editar -->
                                        <Button ToolTip="Editar producto" Cursor="Hand"
                                                Command="{Binding DataContext.EditarProductoCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#E8EAF6" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Editar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#283593" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#C5CAE9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Botón Eliminar -->
                                        <Button ToolTip="Eliminar producto" Cursor="Hand"
                                                Command="{Binding DataContext.EliminarProductoCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#FFEBEE" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,0,0">
                                                        <TextBlock Text="Eliminar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#C62828" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- ═══ FORMULARIO (aparece cuando MostrarFormulario = true) ═══ -->
            <!-- 
            Visibility usa un conversor BooleanToVisibility:
            - MostrarFormulario = true  → Visible
            - MostrarFormulario = false → Collapsed (no ocupa espacio)
            -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Margin="15,0,0,0"
                    Width="320"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Título del formulario (dinámico) -->
                        <TextBlock Text="{Binding TituloFormulario}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#1A237E"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Campo: Nombre del producto -->
                        <TextBlock Text="Nombre *" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" 
                                 FontSize="13"
                                 BorderBrush="#DDD"/>
                        
                        <!-- Campo: Descripción -->
                        <TextBlock Text="Descripción" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormDescripcion, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" 
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"
                                 BorderBrush="#DDD"/>
                        
                        <!-- Campo: Unidad de medida -->
                        <TextBlock Text="Unidad de medida" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <ComboBox ItemsSource="{Binding UnidadesMedida}" 
                                  SelectedItem="{Binding FormUnidad}"
                                  Padding="10,8" 
                                  FontSize="13"/>
                        
                        <!-- Campo: Costo de compra -->
                        <TextBlock Text="Costo de Compra" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormCostoCompra, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" 
                                 FontSize="13"
                                 BorderBrush="#DDD"/>
                        
                        <!-- Campo: Cantidad en stock -->
                        <TextBlock Text="Cantidad en stock" 
                                   FontSize="12" 
                                   Foreground="#666" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormCantidadStock, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="10,8" 
                                 FontSize="13"
                                 BorderBrush="#DDD"/>
                        
                        <!-- Botones: Guardar / Cancelar -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Botón Guardar (azul) -->
                            <Button Grid.Column="0"
                                    Command="{Binding GuardarProductoCommand}"
                                    Padding="0,10"
                                    Cursor="Hand"
                                    FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#4CAF50" CornerRadius="6" Padding="12,10">
                                            <TextBlock Text="💾 Guardar" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="White" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#CCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Botón Cancelar (gris) -->
                            <Button Grid.Column="2"
                                    Command="{Binding CancelarCommand}"
                                    Padding="0,10"
                                    Cursor="Hand"
                                    FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#9E9E9E" CornerRadius="6" Padding="12,10">
                                            <TextBlock Text="✖ Cancelar" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="White" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#757575"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- ═══ PANEL DE AJUSTE DE STOCK (ingreso/salida) ═══ -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Margin="15,0,0,0"
                    Width="300"
                    Visibility="{Binding ModoAjusteStock, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Top">
                <StackPanel>
                    
                    <!-- Título dinámico -->
                    <TextBlock Text="{Binding TituloAjuste}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#1A237E"
                               Margin="0,0,0,15"/>
                    
                    <!-- Info del producto seleccionado -->
                    <Border Background="#F5F5F5" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductoSeleccionado.Nombre}" 
                                       FontSize="15" FontWeight="SemiBold" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Stock actual: " FontSize="12" Foreground="#666"/>
                                <TextBlock Text="{Binding ProductoSeleccionado.StockConUnidad, Mode=OneWay}" 
                                           FontSize="12" Foreground="#333" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Campo: Cantidad -->
                    <TextBlock Text="Cantidad *" 
                               FontSize="12" 
                               Foreground="#666" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding AjusteCantidad, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8" 
                             FontSize="13"
                             BorderBrush="#DDD"/>
                    
                    <!-- Campo: Motivo -->
                    <TextBlock Text="Motivo (opcional)" 
                               FontSize="12" 
                               Foreground="#666" 
                               FontWeight="SemiBold"
                               Margin="0,12,0,5"/>
                    <TextBox Text="{Binding AjusteMotivo, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8" 
                             FontSize="13"
                             TextWrapping="Wrap"
                             Height="50"
                             BorderBrush="#DDD"/>
                    
                    <!-- Botones: Confirmar / Cancelar -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0"
                                Command="{Binding ConfirmarAjusteCommand}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#4CAF50" CornerRadius="6" Padding="12,10">
                                        <TextBlock Text="✅ Confirmar" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#CCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Grid.Column="2"
                                Command="{Binding CancelarAjusteCommand}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#9E9E9E" CornerRadius="6" Padding="12,10">
                                        <TextBlock Text="✖ Cancelar" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="White" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#757575"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                </StackPanel>
            </Border>
            
            <!-- ═══ PANEL DE HISTORIAL DE PRODUCTO ═══ -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Margin="15,0,0,0"
                    Width="380"
                    Visibility="{Binding ModoHistorial, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Título -->
                    <TextBlock Grid.Row="0" 
                               Text="📋 Historial de Movimientos" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#1A237E"
                               Margin="0,0,0,10"/>
                    
                    <!-- Info del producto -->
                    <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductoHistorial.Nombre}" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Stock: " FontSize="11" Foreground="#666"/>
                                <TextBlock Text="{Binding ProductoHistorial.StockConUnidad}" 
                                           FontSize="11" Foreground="#333" FontWeight="SemiBold"/>
                                <TextBlock Text="  ·  Costo: " FontSize="11" Foreground="#666" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding ProductoHistorial.CostoCompra, StringFormat=$ {0:N2} CUP}" 
                                           FontSize="11" Foreground="#333" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Lista de movimientos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistorialProducto}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                                            BorderBrush="#E0E0E0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Icono tipo -->
                                            <Border Grid.Column="0" Grid.RowSpan="2" 
                                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Width="28" Height="28" CornerRadius="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Categoria}" Value="Otro">
                                                                <Setter Property="Background" Value="#FFF3E0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="📥"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Categoria}" Value="Otro">
                                                                    <Setter Property="Text" Value="📤"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- Concepto -->
                                            <TextBlock Grid.Column="1" Grid.Row="0" 
                                                       Text="{Binding Concepto}" 
                                                       FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#333"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Monto -->
                                            <TextBlock Grid.Column="2" Grid.Row="0" 
                                                       Text="{Binding Monto, StringFormat=$ {0:N2}}" 
                                                       FontSize="12" FontWeight="Bold" 
                                                       Foreground="#1A237E"
                                                       HorizontalAlignment="Right"/>
                                            
                                            <!-- Descripción + fecha -->
                                            <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Descripcion}" 
                                                           FontSize="10" Foreground="#888"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200"/>
                                                <TextBlock Text=" · " FontSize="10" Foreground="#CCC"/>
                                                <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM/yy HH:mm}}" 
                                                           FontSize="10" Foreground="#AAA"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Botón cerrar -->
                    <Button Grid.Row="3" 
                            Command="{Binding CerrarHistorialCommand}"
                            Cursor="Hand"
                            Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#9E9E9E" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="✖ Cerrar" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#757575"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 3: BARRA DE ESTADO -->
        <!-- Muestra mensajes del ViewModel (ej: "Producto guardado") -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" 
                Background="#1A237E" 
                CornerRadius="6"
                Padding="16,10"
                Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding MensajeEstado}" 
                           FontSize="12" 
                           Foreground="#B0BEC5"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="VALOR DEL INVENTARIO" 
                               FontSize="11" 
                               Foreground="#90CAF9"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border Background="#283593" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding CostoTotalInventario, StringFormat=$ {0:N2} CUP}" 
                                   FontSize="15" 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

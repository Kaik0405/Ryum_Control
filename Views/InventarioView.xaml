<UserControl x:Class="GestionApp.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:InventarioViewModel}"
             d:DesignHeight="700" d:DesignWidth="950"
             Background="Transparent">

    <!-- 
    CÓMO FUNCIONA ESTA VISTA:
    
    La vista se conecta al InventarioViewModel mediante "Bindings".
    Ejemplo: Text="{Binding Filtro}" conecta el TextBox a la propiedad Filtro del ViewModel.
    Cuando el usuario escribe, el ViewModel recibe el texto y filtra la lista.
    
    Los botones usan Command="{Binding NombreCommand}" para ejecutar acciones.
    -->

    <!-- Conversor para mostrar/ocultar el formulario -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Fila 0: Encabezado -->
            <RowDefinition Height="Auto"/>   <!-- Fila 1: Filtros -->
            <RowDefinition Height="*"/>      <!-- Fila 2: Contenido principal -->
            <RowDefinition Height="Auto"/>   <!-- Fila 3: Barra de estado -->
        </Grid.RowDefinitions>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 0: ENCABEZADO - Título y botón de acción -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📦 Inventario" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#142F49"/>
                    <TextBlock Text="Gestión de productos y stock" 
                               FontSize="11" 
                               Foreground="#657C91"
                               Margin="0,2,0,0"/>
                </StackPanel>
            
                <!-- Botón principal: abre el formulario de nuevo producto -->
                <Button Grid.Column="1" 
                        Command="{Binding NuevoProductoCommand}"
                        Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" 
                                    Background="#173F63" 
                                    CornerRadius="8" 
                                    Padding="18,9">
                                <TextBlock Text="➕ Nuevo Producto" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#173F63"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2A638F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 1: BARRA DE FILTROS -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,10"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Buscador (cápsula con icono 🔍) -->
                <Border Grid.Column="0" Background="#F9FBFD" CornerRadius="10" Padding="4,0"
                        BorderBrush="#D1DDE8" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E9F0F6" CornerRadius="8" 
                                Width="30" Height="30" Margin="2,3,0,3" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8,7" FontSize="12" BorderThickness="0" Background="Transparent"
                                 Foreground="#203B54" VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar producto por nombre, descripción o categoría..." 
                                                                       Foreground="#657C91" Margin="10,0,0,0" FontSize="12"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                
                <!-- CheckBox en cápsula -->
                <Border Grid.Column="2" Background="#F2F6FA" CornerRadius="10" Padding="12,6"
                        BorderBrush="#D1DDE8" BorderThickness="1">
                    <CheckBox Content=" Solo en stock" 
                              IsChecked="{Binding MostrarSoloEnStock}"
                              VerticalAlignment="Center"
                              FontSize="12" Foreground="#465E75"/>
                </Border>
                
                <!-- Botón actualizar (cápsula) -->
                <Button Grid.Column="4" Command="{Binding RefrescarCommand}" Cursor="Hand"
                        ToolTip="Recargar lista">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,6"
                                    BorderBrush="#D1DDE8" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Actualizar" FontSize="12" FontWeight="SemiBold" Foreground="#465E75" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 2: CONTENIDO PRINCIPAL (DataGrid + Formulario) -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>          <!-- Columna 0: Lista de productos -->
                <ColumnDefinition Width="Auto"/>       <!-- Columna 1: Formulario (aparece/desaparece) -->
            </Grid.ColumnDefinitions>
            
            <!-- ═══ LISTA DE PRODUCTOS (DataGrid) ═══ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,0">
                <DataGrid ItemsSource="{Binding ProductosFiltrados}" 
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="46"
                          FontSize="13"
                          SelectionMode="Single">
                    
                    <!-- Estilo de cabeceras -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FBFD"/>
                            <Setter Property="Foreground" Value="#203B54"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderBrush" Value="#D1DDE8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <!-- Estilo de filas -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="46"/>
                            <Setter Property="Padding" Value="0,4"/>
                            <Style.Triggers>
                                <!-- Verde suave si está en stock -->
                                <DataTrigger Binding="{Binding EnStock}" Value="True">
                                    <Setter Property="Background" Value="#EDF6F0"/>
                                </DataTrigger>
                                <!-- Rojo suave si no está en stock -->
                                <DataTrigger Binding="{Binding EnStock}" Value="False">
                                    <Setter Property="Background" Value="#FCECEF"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF1F7"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F2F6FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" 
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#17324B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <!-- COLUMNAS: cada una conectada a una propiedad del modelo Producto -->
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="120" SortMemberPath="Nombre">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" 
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="320">
                                                <StackPanel Margin="4">
                                                    <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Descripcion, TargetNullValue='Sin descripción'}" 
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#536A80" Margin="0,6,0,0"/>
                                                    <Border BorderBrush="#D1DDE8" BorderThickness="0,1,0,0" Margin="0,8,0,4" Padding="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Stock: " FontSize="11" Foreground="#657C91"/>
                                                            <TextBlock Text="{Binding StockConUnidad}" FontSize="11" Foreground="#203B54" FontWeight="SemiBold"/>
                                                            <TextBlock Text="  ·  Costo: " FontSize="11" Foreground="#657C91" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding CostoCompra, StringFormat=$ {0:N2}}" FontSize="11" Foreground="#203B54" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Unidad" 
                                            Binding="{Binding Unidad}" 
                                            Width="80"/>
                        
                        <DataGridTextColumn Header="Costo" 
                                            Binding="{Binding CostoCompra, StringFormat=$ {0:N2}}" 
                                            Width="100"/>
                        
                        <DataGridTemplateColumn Header="Stock" 
                                            Width="110" SortMemberPath="CantidadStock">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockConUnidad}" VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#287A56"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EnStock}" Value="False">
                                                        <Setter Property="Foreground" Value="#B74756"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Costo Total" 
                                            Binding="{Binding CostoTotal, StringFormat=$ {0:N2}}" 
                                            Width="120"/>
                        
                        <DataGridTextColumn Header="Ingreso" 
                                            Binding="{Binding FechaIngreso, StringFormat={}{0:dd/MM/yyyy}}" 
                                            Width="100"/>
                        
                        <!-- Columna de acciones: Stock +/−, Historial, Editar, Eliminar -->
                        <DataGridTemplateColumn Header="Acciones" Width="350">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Botón Agregar stock -->
                                        <Button ToolTip="Ingresar stock" Cursor="Hand"
                                                Command="{Binding DataContext.IngresarStockCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#E8F4EC" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Agregar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#287A56" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#CBE6D4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Botón Quitar stock -->
                                        <Button ToolTip="Dar salida" Cursor="Hand"
                                                Command="{Binding DataContext.SacarStockCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#FFF4D6" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Quitar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#9B7100" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFF1CF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Separador -->
                                        <Border Width="1" Background="#D1DDE8" Margin="3,4" VerticalAlignment="Stretch"/>
                                        <!-- Botón Historial -->
                                        <Button ToolTip="Ver historial" Cursor="Hand"
                                                Command="{Binding DataContext.VerHistorialCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#EAF1F7" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Historial" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#173F63" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#DDE8F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Separador -->
                                        <Border Width="1" Background="#D1DDE8" Margin="3,4" VerticalAlignment="Stretch"/>
                                        <!-- Botón Editar -->
                                        <Button ToolTip="Editar producto" Cursor="Hand"
                                                Command="{Binding DataContext.EditarProductoCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#173F63" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,4,0">
                                                        <TextBlock Text="Editar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#244B6A" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#425B87"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Botón Eliminar -->
                                        <Button ToolTip="Eliminar producto" Cursor="Hand"
                                                Command="{Binding DataContext.EliminarProductoCommand, 
                                                         RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#FCECEF" CornerRadius="6" 
                                                            Padding="10,4" Margin="0,0,0,0">
                                                        <TextBlock Text="Eliminar" FontSize="11" FontWeight="SemiBold" 
                                                                   Foreground="#B74756" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#F8D8DD"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Capa que evita clics accidentales en la tabla mientras se edita. -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#660D2945" Panel.ZIndex="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarFormulario}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding ModoAjusteStock}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <DataTrigger Binding="{Binding ModoHistorial}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- ═══ FORMULARIO (aparece cuando MostrarFormulario = true) ═══ -->
            <!-- 
            Visibility usa un conversor BooleanToVisibility:
            - MostrarFormulario = true  → Visible
            - MostrarFormulario = false → Collapsed (no ocupa espacio)
            -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="12" Width="590" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        
                        <!-- Título del formulario (dinámico) -->
                        <TextBlock Text="{Binding TituloFormulario}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#142F49"
                                   Margin="0,0,0,20"/>
                        
                        <!-- Campo: Nombre del producto -->
                        <TextBlock Text="Nombre *" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8,5" 
                                 FontSize="13"
                                 BorderBrush="#D1DDE8"/>
                        
                        <!-- Campo: Descripción -->
                        <TextBlock Text="Descripción" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormDescripcion, UpdateSourceTrigger=PropertyChanged}" 
                                 Padding="8,5" 
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="50"
                                 BorderBrush="#D1DDE8"/>
                        
                        <!-- Campo: Unidad de medida -->
                        <TextBlock Text="Unidad de medida" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <ComboBox ItemsSource="{Binding UnidadesMedida}" 
                                  SelectedItem="{Binding FormUnidad}"
                                  Padding="8,5" 
                                  FontSize="13"/>
                                                <!-- Campo: Tipo de adquisición -->
                        <TextBlock Text="Tipo de adquisición" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="TipoAdq" Content="🛒 Compra" 
                                         IsChecked="{Binding FormEsEntrega, Converter={StaticResource InverseBoolConverter}}"
                                         FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="4,0"/>
                            <RadioButton Grid.Column="1" GroupName="TipoAdq" Content="📦 Entrega" 
                                         IsChecked="{Binding FormEsEntrega}"
                                         FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="4,0"/>
                        </Grid>
                        <!-- Campo: Costo de compra -->
                        <TextBlock Text="Costo de Compra" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormCostoCompra, UpdateSourceTrigger=PropertyChanged}" 
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 Padding="8,5" 
                                 FontSize="13"
                                 BorderBrush="#D1DDE8"/>
                        
                        <!-- Campo: Cantidad en stock -->
                        <TextBlock Text="Cantidad en stock" 
                                   FontSize="12" 
                                   Foreground="#536A80" 
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,5"/>
                        <TextBox Text="{Binding FormCantidadStock, UpdateSourceTrigger=PropertyChanged}" 
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 Padding="8,5" 
                                 FontSize="13"
                                 BorderBrush="#D1DDE8"/>
                        
                        <!-- Botones: Guardar / Cancelar -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Botón Guardar (verde outline) -->
                            <Button Grid.Column="0"
                                    Command="{Binding GuardarProductoCommand}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="6" Padding="12,10"
                                                BorderBrush="#287A56" BorderThickness="1.5">
                                            <TextBlock x:Name="txt" Text="Guardar" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="#287A56" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#287A56"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#73879B"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#73879B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <!-- Botón Cancelar (rojo outline) -->
                            <Button Grid.Column="2"
                                    Command="{Binding CancelarCommand}"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="6" Padding="12,10"
                                                BorderBrush="#B74756" BorderThickness="1.5">
                                            <TextBlock x:Name="txt" Text="Cancelar" 
                                                       HorizontalAlignment="Center" 
                                                       Foreground="#B74756" 
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#B74756"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- ═══ PANEL DE AJUSTE DE STOCK (ingreso/salida) ═══ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="12" Width="500" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" Visibility="{Binding ModoAjusteStock, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    
                    <!-- Título dinámico -->
                    <TextBlock Text="{Binding TituloAjuste}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#142F49"
                               Margin="0,0,0,15"/>
                    
                    <!-- Info del producto seleccionado -->
                    <Border Background="#F2F6FA" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductoSeleccionado.Nombre}" 
                                       FontSize="15" FontWeight="SemiBold" Foreground="#203B54"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="Stock actual: " FontSize="12" Foreground="#536A80"/>
                                <TextBlock Text="{Binding ProductoSeleccionado.StockConUnidad, Mode=OneWay}" 
                                           FontSize="12" Foreground="#203B54" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Campo: Cantidad -->
                    <TextBlock Text="Cantidad *" 
                               FontSize="12" 
                               Foreground="#536A80" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding AjusteCantidad, UpdateSourceTrigger=PropertyChanged}" 
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             Padding="8,5" 
                             FontSize="13"
                             BorderBrush="#D1DDE8"/>
                    
                    <!-- Campo: Motivo -->
                    <TextBlock Text="Motivo (opcional)" 
                               FontSize="12" 
                               Foreground="#536A80" 
                               FontWeight="SemiBold"
                               Margin="0,12,0,5"/>
                    <TextBox Text="{Binding AjusteMotivo, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="8,5" 
                             FontSize="13"
                             TextWrapping="Wrap"
                             Height="50"
                             BorderBrush="#D1DDE8"/>
                    
                    <!-- Botones: Confirmar / Cancelar -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0"
                                Command="{Binding ConfirmarAjusteCommand}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FFFFFF" CornerRadius="6" Padding="12,10"
                                            BorderBrush="#287A56" BorderThickness="1.5">
                                        <TextBlock x:Name="txt" Text="✅ Confirmar" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="#287A56" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#287A56"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#F2F6FA"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#73879B"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#73879B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Grid.Column="2"
                                Command="{Binding CancelarAjusteCommand}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#FFFFFF" CornerRadius="6" Padding="12,10"
                                            BorderBrush="#B74756" BorderThickness="1.5">
                                        <TextBlock x:Name="txt" Text="✖ Cancelar" 
                                                   HorizontalAlignment="Center" 
                                                   Foreground="#B74756" 
                                                   FontWeight="SemiBold"
                                                   FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#B74756"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                </StackPanel>
            </Border>
            
            <!-- ═══ PANEL DE HISTORIAL DE PRODUCTO ═══ -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Margin="12" Width="590" MaxWidth="700" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" Visibility="{Binding ModoHistorial, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Título -->
                    <TextBlock Grid.Row="0" 
                               Text="📋 Historial de Movimientos" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="#142F49"
                               Margin="0,0,0,10"/>
                    
                    <!-- Info del producto -->
                    <Border Grid.Row="1" Background="#F2F6FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductoHistorial.Nombre}" 
                                       FontSize="14" FontWeight="SemiBold" Foreground="#203B54"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Stock: " FontSize="11" Foreground="#536A80"/>
                                <TextBlock Text="{Binding ProductoHistorial.StockConUnidad}" 
                                           FontSize="11" Foreground="#203B54" FontWeight="SemiBold"/>
                                <TextBlock Text="  ·  Costo: " FontSize="11" Foreground="#536A80" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding ProductoHistorial.CostoCompra, StringFormat=$ {0:N2} CUP}" 
                                           FontSize="11" Foreground="#203B54" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Lista de movimientos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistorialProducto}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                                            BorderBrush="#D1DDE8" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Icono tipo -->
                                            <Border Grid.Column="0" Grid.RowSpan="2" 
                                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Width="28" Height="28" CornerRadius="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F4EC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Categoria}" Value="Otro">
                                                                <Setter Property="Background" Value="#FFF4D6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="📥"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Categoria}" Value="Otro">
                                                                    <Setter Property="Text" Value="📤"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            
                                            <!-- Concepto -->
                                            <TextBlock Grid.Column="1" Grid.Row="0" 
                                                       Text="{Binding Concepto}" 
                                                       FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#203B54"
                                                       TextTrimming="CharacterEllipsis"/>
                                            
                                            <!-- Monto -->
                                            <TextBlock Grid.Column="2" Grid.Row="0" 
                                                       Text="{Binding Monto, StringFormat=$ {0:N2}}" 
                                                       FontSize="12" FontWeight="Bold" 
                                                       Foreground="#142F49"
                                                       HorizontalAlignment="Right"/>
                                            
                                            <!-- Descripción + fecha -->
                                            <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Descripcion}" 
                                                           FontSize="10" Foreground="#657C91"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200"/>
                                                <TextBlock Text=" · " FontSize="10" Foreground="#73879B"/>
                                                <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM/yy HH:mm}}" 
                                                           FontSize="10" Foreground="#70869A"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Botón cerrar -->
                    <Button Grid.Row="3" 
                            Command="{Binding CerrarHistorialCommand}"
                            Cursor="Hand"
                            Margin="0,10,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#73879B" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="✖ Cerrar" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" 
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#8FA3BE"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 3: BARRA DE ESTADO -->
        <!-- Muestra mensajes del ViewModel (ej: "Producto guardado") -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" 
                Background="#142F49" 
                CornerRadius="6"
                Padding="16,10"
                Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding MensajeEstado}" 
                           FontSize="12" 
                           Foreground="#758AA5"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="VALOR DEL INVENTARIO" 
                               FontSize="11" 
                               Foreground="#CBD8E5"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border Background="#244B6A" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding CostoTotalInventario, StringFormat=$ {0:N2} CUP}" 
                                   FontSize="15" 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="GestionApp.Views.CombosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CombosViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:ComboColorConverter x:Key="ComboColor"/>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ═══ FILA 0: ENCABEZADO ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="🎁 Combos" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#1A237E"/>
                <TextBlock Text="Combos predefinidos para envío — el costo se calcula en la ficha" 
                           FontSize="14" 
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Grid.Column="1" 
                    Command="{Binding CrearComboCommand}"
                    Background="#7B1FA2" 
                    Foreground="White"
                    Padding="20,10"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6A1B9A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="➕ Nuevo Combo" Foreground="White" FontWeight="SemiBold"/>
            </Button>
        </Grid>
        
        <!-- ═══ FILA 1: FILTROS ═══ -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,15"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8"
                         FontSize="13"
                         BorderBrush="#DDD"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Buscar combo..." 
                                                               Foreground="#999" Margin="12,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                
                <Button Grid.Column="1"
                        Command="{Binding RefrescarCommand}"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="#DDD"
                        Padding="10,6"
                        Cursor="Hand"
                        ToolTip="Recargar lista"
                        Margin="10,0,0,0">
                    <TextBlock Text="🔄" FontSize="16"/>
                </Button>
            </Grid>
        </Border>
        
        <!-- ═══ FILA 2: CONTENIDO PRINCIPAL ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- ═══ CUADRÍCULA DE COMBOS (tarjetas en grid) ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,5,0">
                <ItemsControl ItemsSource="{Binding CombosFiltrados}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ═══ TARJETA DE COMBO ═══ -->
                            <Border Width="265" Margin="0,0,12,12" CornerRadius="12"
                                    BorderThickness="2" Background="White"
                                    BorderBrush="{Binding Id, Converter={StaticResource ComboColor}}"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- HEADER: Precio + Tipo badge -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="14,10,14,8"
                                            Background="{Binding Id, Converter={StaticResource ComboColor}, ConverterParameter=bg}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PrecioVenta, StringFormat='$ {0:N2}'}" 
                                                           FontSize="22" FontWeight="Bold"
                                                           Foreground="{Binding Id, Converter={StaticResource ComboColor}}"/>
                                                <TextBlock Text="USD" FontSize="10" Foreground="#999" 
                                                           FontWeight="SemiBold" Margin="0,-2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                    VerticalAlignment="Top"
                                                    Background="{Binding Id, Converter={StaticResource ComboColor}}">
                                                <TextBlock Text="{Binding Tipo}" FontSize="10" 
                                                           Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- NOMBRE DEL COMBO CON NÚMERO -->
                                    <Border Grid.Row="1" Padding="14,8,14,4">
                                        <TextBlock FontSize="15" FontWeight="Bold" 
                                                   Foreground="#333" TextTrimming="CharacterEllipsis">
                                            <Run Text="#"/><Run Text="{Binding Numero, Mode=OneWay}"/>
                                            <Run Text=" — "/><Run Text="{Binding Nombre, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    
                                    <!-- LISTA DE PRODUCTOS -->
                                    <Border Grid.Row="2" Padding="14,2,14,6" MinHeight="60" MaxHeight="180">
                                        <ItemsControl ItemsSource="{Binding Productos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                        <TextBlock Text="•" Foreground="#BDBDBD" FontSize="12" 
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock FontSize="12" Foreground="#555" 
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{Binding NombreProducto, Mode=OneWay}" FontWeight="Medium"/>
                                                            <Run Text=" — " Foreground="#CCC"/>
                                                            <Run Text="{Binding Descripcion, Mode=OneWay}" Foreground="#888"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    
                                    <!-- BOTONES DE ACCIÓN -->
                                    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="#F0F0F0"
                                            Padding="8,6" CornerRadius="0,0,10,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Productos.Count, StringFormat='{}{0} producto(s)'}" 
                                                       FontSize="11" Foreground="#AAA"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            
                                            <!-- Editar -->
                                            <Button Grid.Column="1" ToolTip="Editar" Cursor="Hand"
                                                    Command="{Binding DataContext.EditarComboCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Padding="8,5" Margin="0,0,3,0">
                                                            <TextBlock Text="✏️" FontSize="13"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E8EAF6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            
                                            <!-- Duplicar -->
                                            <Button Grid.Column="2" ToolTip="Duplicar" Cursor="Hand"
                                                    Command="{Binding DataContext.DuplicarComboCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Padding="8,5" Margin="0,0,3,0">
                                                            <TextBlock Text="📋" FontSize="13"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E8F5E9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            
                                            <!-- Eliminar -->
                                            <Button Grid.Column="3" ToolTip="Eliminar" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarComboCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Padding="8,5">
                                                            <TextBlock Text="🗑" FontSize="13"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#FFEBEE"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- ═══ FORMULARIO CREAR/EDITAR COMBO ═══ -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Margin="10,0,0,0"
                    Width="340"
                    Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Título -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding TituloFormulario}" 
                               FontSize="17" FontWeight="Bold" Foreground="#1A237E"
                               Margin="0,0,0,12"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Número del combo -->
                            <TextBlock Text="Número del Combo *" FontSize="12" Foreground="#555" 
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FormNumero, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD" Margin="0,0,0,12"/>

                            <!-- Nombre -->
                            <TextBlock Text="Nombre *" FontSize="12" Foreground="#555" 
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding FormNombre, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                            
                            <!-- Tipo -->
                            <TextBlock Text="Tipo" FontSize="12" Foreground="#555" 
                                       FontWeight="SemiBold" Margin="0,12,0,5"/>
                            <ComboBox ItemsSource="{Binding TiposCombo}" 
                                      SelectedItem="{Binding FormTipo}"
                                      Padding="10,8" FontSize="13"/>
                            
                            <!-- Precio de venta -->
                            <TextBlock Text="Precio de Venta (USD)" FontSize="12" Foreground="#555" 
                                       FontWeight="SemiBold" Margin="0,12,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#7B1FA2" CornerRadius="4,0,0,4" Padding="10,8">
                                    <TextBlock Text="$" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                </Border>
                                <TextBox Grid.Column="1"
                                         Text="{Binding FormPrecioVenta, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                            </Grid>
                            
                            <!-- Separador -->
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="0,16,0,12"/>
                            
                            <!-- AGREGAR PRODUCTO -->
                            <TextBlock Text="Agregar Producto" FontSize="13" FontWeight="Bold" 
                                       Foreground="#333" Margin="0,0,0,8"/>
                            
                            <!-- Nombre del producto -->
                            <TextBox Text="{Binding FormNombreProducto, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD" Margin="0,0,0,6">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="Nombre del producto..." 
                                                                           Foreground="#BBB" Margin="12,0,0,0" FontSize="12"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            
                            <!-- Cantidad + Unidad + Botón Agregar -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Text="{Binding FormCantidadProducto, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="8,7" FontSize="12" BorderBrush="#DDD">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Cant." Foreground="#BBB" 
                                                                               Margin="10,0,0,0" FontSize="11"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding UnidadesMedida}"
                                          SelectedItem="{Binding FormUnidadProducto}"
                                          Padding="8,7" FontSize="12" Margin="5,0,0,0"/>
                                
                                <Button Grid.Column="2" 
                                        Command="{Binding AgregarProductoCommand}"
                                        Margin="5,0,0,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#4CAF50" CornerRadius="6" 
                                                    Padding="12,7">
                                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" 
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Background" Value="#CCC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            
                            <!-- Lista de productos agregados -->
                            <ItemsControl ItemsSource="{Binding ProductosDelCombo}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="10,7" CornerRadius="8"
                                                Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding NombreProducto}" 
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#333"/>
                                                    <TextBlock Text="{Binding Descripcion, Mode=OneWay}" 
                                                               FontSize="10" Foreground="#888" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" 
                                                        Command="{Binding DataContext.QuitarProductoCommand, 
                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand" VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="#FFEBEE" CornerRadius="4" 
                                                                    Padding="7,4">
                                                                <TextBlock Text="✕" FontSize="10" Foreground="#D32F2F"
                                                                           HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Botones Guardar / Cancelar -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Command="{Binding GuardarComboCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#4CAF50" CornerRadius="8" Padding="12,10">
                                        <TextBlock Text="💾 Guardar" HorizontalAlignment="Center" 
                                                   Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#43A047"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#CCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Grid.Column="2" Command="{Binding CancelarCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#9E9E9E" CornerRadius="8" Padding="12,10">
                                        <TextBlock Text="✖ Cancelar" HorizontalAlignment="Center" 
                                                   Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#757575"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ═══ FILA 3: BARRA DE ESTADO ═══ -->
        <Border Grid.Row="3" 
                Background="#4A148C" 
                CornerRadius="8"
                Padding="16,10"
                Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding MensajeEstado}" 
                           FontSize="12" 
                           Foreground="#CE93D8"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="COMBOS ACTIVOS" 
                               FontSize="11" 
                               Foreground="#CE93D8"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border Background="#6A1B9A" CornerRadius="6" Padding="12,4">
                        <TextBlock Text="{Binding CombosFiltrados.Count}" 
                                   FontSize="15" 
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

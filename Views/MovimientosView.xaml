<UserControl x:Class="GestionApp.Views.MovimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MovimientosViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
        <h:CurrencyFormatConverter x:Key="CurrencyFmt"/>
    </UserControl.Resources>

    <Grid>
        <!-- Overlay del formulario -->
        <Grid Panel.ZIndex="100" 
              Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVis}}">
            <Border Background="#80000000" MouseDown="OverlayBackground_Click"/>
            <Border Background="White" CornerRadius="12" Padding="28,24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="520" MaxHeight="600">
                <StackPanel>
                    <!-- Header del form -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="{Binding TituloFormulario}" FontSize="20" FontWeight="Bold" Foreground="#1A237E"/>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CancelarCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#999"
                                Padding="4,0"/>
                    </Grid>

                    <!-- Tipo indicador -->
                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormTipo}" Value="Egreso">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="📥 INGRESO"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormTipo}" Value="Egreso">
                                            <Setter Property="Text" Value="📤 EGRESO"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Monto -->
                    <TextBlock Text="MONTO (CUP) *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormMonto, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             Padding="10,8" FontSize="16" FontWeight="Bold" BorderBrush="#DDD" Margin="0,0,0,14"/>

                    <!-- Fecha -->
                    <TextBlock Text="FECHA" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FormFecha}" Padding="6" Margin="0,0,0,14"/>

                    <!-- Descripción -->
                    <TextBlock Text="DESCRIPCIÓN *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDescripcion, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50"
                             Padding="10,8" FontSize="12" BorderBrush="#DDD" Margin="0,0,0,20"/>

                    <!-- Botones -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CancelarCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="White" CornerRadius="8" Padding="16,10"
                                            BorderBrush="#E53935" BorderThickness="1.5">
                                        <TextBlock x:Name="txt" Text="Cancelar" Foreground="#E53935" 
                                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E53935"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding GuardarCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="White" CornerRadius="8" Padding="20,10"
                                            BorderBrush="#4CAF50" BorderThickness="1.5">
                                        <TextBlock x:Name="txt" Text="💾 Guardar" Foreground="#4CAF50" 
                                                   FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CCC"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#CCC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Contenido principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">

                <!-- ═══════════════════════════════════════ -->
                <!-- ENCABEZADO                              -->
                <!-- ═══════════════════════════════════════ -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Finanzas" FontSize="28" FontWeight="Bold" Foreground="#1A237E"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Control de ingresos, egresos y balance financiero" FontSize="13" Foreground="#666"/>
                            <Border Background="#FFF3E0" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="#E65100" FontWeight="SemiBold">
                                    <Run Text="💱 1 USD = "/>
                                    <Run Text="{Binding TasaCambio, Mode=OneWay, StringFormat='{}{0:N0}'}"/>
                                    <Run Text=" CUP"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NuevoIngresoCommand}" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2E7D32" CornerRadius="8" Padding="18,10">
                                        <TextBlock Text="📥 Nuevo Ingreso" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#388E3C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding NuevoEgresoCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#C62828" CornerRadius="8" Padding="18,10">
                                        <TextBlock Text="📤 Nuevo Egreso" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- KPI CARDS — Primera fila (4 tarjetas)   -->
                <!-- ═══════════════════════════════════════ -->
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <!-- Balance en existencia -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="💰 Dinero en existencia" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding BalanceGlobal, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Balance global acumulado" FontSize="9" Foreground="#AAA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Total invertido -->
                    <Border Style="{StaticResource CardStyle}" Margin="4,0,4,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="📦 Invertido (productos + transporte)" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalInvertido, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#E65100" Margin="0,6,0,0"/>
                            <TextBlock Text="Gasto acumulado en inventario (CUP)" FontSize="9" Foreground="#AAA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Ganancia acumulada -->
                    <Border Margin="4,0,4,0" Padding="16,14">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="BorderBrush" Value="#FFCDD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="#888" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="📈 Ganancia acumulada"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                                <Setter Property="Text" Value="📉 PÉRDIDA acumulada"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding GananciaAcumulada, StringFormat='${0:N2} USD'}" 
                                       FontSize="24" FontWeight="Bold" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Ingresos totales - Egresos totales (USD)" FontSize="9" Foreground="#AAA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Ganancia distribuidor -->
                    <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="👤 Ganancia del distribuidor" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GananciaDistribuidor, StringFormat='${0:N2} USD'}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,6,0,0"/>
                            <TextBlock Text="12% del precio de cada combo" FontSize="9" Foreground="#AAA" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══════════════════════════════════════ -->
                <!-- KPI CARDS — Segunda fila (6 mini)       -->
                <!-- ═══════════════════════════════════════ -->
                <UniformGrid Columns="7" Margin="0,0,0,16">
                    <!-- Ingresos período -->
                    <Border Margin="0,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Ingresos">
                                        <Setter Property="BorderBrush" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Ingresos"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Ingresos (período)" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalIngresos, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Egresos período -->
                    <Border Margin="2,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Egresos">
                                        <Setter Property="BorderBrush" Value="#C62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Egresos"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="Egresos (período)" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalEgresos, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Gasto productos -->
                    <Border Margin="2,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#E65100"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Productos">
                                        <Setter Property="BorderBrush" Value="#E65100"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Productos"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🛒 Productos" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GastoProductos, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Gasto transporte -->
                    <Border Margin="2,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#F57F17"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Transporte">
                                        <Setter Property="BorderBrush" Value="#F57F17"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Transporte"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="🚚 Transporte" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GastoTransporte, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#F57F17" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Rebaja (descontado en fichas) -->
                    <Border Margin="2,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#5D4037"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Rebaja">
                                        <Setter Property="BorderBrush" Value="#5D4037"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Rebaja"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📦 Rebaja" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GastoRebaja, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#5D4037" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Gasto remesas -->
                    <Border Margin="2,0,4,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#00695C"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Remesas">
                                        <Setter Property="BorderBrush" Value="#00695C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Remesas"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="💵 Remesas" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GastoRemesas, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#00695C" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Otros (extracciones) -->
                    <Border Margin="4,0,0,0" Padding="10,10" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#546E7A"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CategoriaFiltroActiva}" Value="Otros">
                                        <Setter Property="BorderBrush" Value="#546E7A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" 
                                          Command="{Binding FiltrarPorCategoriaCommand}" CommandParameter="Otros"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="📋 Otros" FontSize="9" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GastoOtros, StringFormat='{}{0:N0} CUP'}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#546E7A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══════════════════════════════════════ -->
                <!-- FILTROS                                  -->
                <!-- ═══════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Búsqueda a la izquierda, ocupa todo el espacio -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="🔍 BUSCAR" FontSize="9" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="DESDE" FontSize="9" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding FechaDesde}" Width="130" Padding="4"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="HASTA" FontSize="9" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding FechaHasta}" Width="130" Padding="4"/>
                        </StackPanel>

                        <!-- Acciones sobre selección -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Command="{Binding EditarCommand}" Cursor="Hand" Margin="0,0,6,0"
                                    Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#E3F2FD" CornerRadius="6" Padding="12,7">
                                            <TextBlock Text="✏️ Editar" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding EliminarCommand}" Cursor="Hand"
                                    Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFEBEE" CornerRadius="6" Padding="12,7">
                                            <TextBlock Text="🗑️ Eliminar" FontSize="11" FontWeight="SemiBold" Foreground="#C62828"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mensaje de estado -->
                <TextBlock Text="{Binding MensajeEstado}" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <!-- ═══════════════════════════════════════ -->
                <!-- TABLA DE MOVIMIENTOS                     -->
                <!-- ═══════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8F9FA" Padding="16,10" CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="📋 Movimientos del período" FontSize="13" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#888" VerticalAlignment="Center">
                                    <Run Text="{Binding Movimientos.Count, Mode=OneWay}"/>
                                    <Run Text=" registros"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding Movimientos}"
                                  SelectedItem="{Binding MovimientoSeleccionado}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="None"
                                  RowHeight="38"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  MaxHeight="400"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FECHA" 
                                                    Binding="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                                    Width="95"/>
                                <!-- Tipo con color -->
                                <DataGridTemplateColumn Header="TIPO" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Egreso">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="📥 Ingreso"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Egreso">
                                                                    <Setter Property="Text" Value="📤 Egreso"/>
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Monto con color -->
                                <DataGridTemplateColumn Header="MONTO" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Monto, StringFormat='+{0:N0} CUP'}"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tipo}" Value="Egreso">
                                                                <Setter Property="Text" Value="{Binding Monto, StringFormat='-{0:N0} CUP'}"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════ -->
                <!-- GANANCIA POR FICHA DE COSTO              -->
                <!-- ═══════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F3E5F5" Padding="16,10" CornerRadius="8,8,0,0">
                            <Grid>
                                <TextBlock Text="📊 Ganancia por Ficha de Costo" FontSize="13" FontWeight="Bold" Foreground="#6A1B9A"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#888" VerticalAlignment="Center">
                                    <Run Text="💱 1 USD = "/>
                                    <Run Text="{Binding TasaCambio, Mode=OneWay, StringFormat='{}{0:N0}'}"/>
                                    <Run Text=" CUP  |  Distrib. = 12% del precio USD"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FichasResumen}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="None"
                                  RowHeight="36"
                                  HeadersVisibility="Column"
                                  MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#666"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                            <Setter Property="Background" Value="#FFF5F5"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="FICHA" Binding="{Binding NumeroFicha}" Width="80"/>
                                <DataGridTextColumn Header="RECEPTOR" Binding="{Binding Receptor}" Width="120"/>
                                <DataGridTextColumn Header="AGENCIA" Binding="{Binding Agencia}" Width="80"/>
                                <DataGridTextColumn Header="FECHA" Binding="{Binding FechaEnvio, StringFormat='{}{0:dd/MM/yy}'}" Width="70"/>
                                <DataGridTextColumn Header="VENTA (USD)" Binding="{Binding PrecioVentaUSD, StringFormat='${0:N2}'}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="VENTA (CUP)" Binding="{Binding PrecioVentaCUP, StringFormat='{}{0:N0}'}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PRODUCTOS" Binding="{Binding CostoProductosCUP, StringFormat='{}{0:N0}'}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TRANSPORTE" Binding="{Binding CostoTransporteCUP, StringFormat='{}{0:N0}'}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F57F17"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Ganancia USD con rojo si pérdida -->
                                <DataGridTemplateColumn Header="GANANCIA" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GananciaUSD, StringFormat='${0:N2}'}" 
                                                       FontWeight="Bold" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HayPerdida}" Value="True">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="DISTRIB. 12%" Binding="{Binding GananciaDistribuidor, StringFormat='${0:N2}'}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

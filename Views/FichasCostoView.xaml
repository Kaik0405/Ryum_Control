<UserControl x:Class="GestionApp.Views.FichasCostoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FichasCostoViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Fichas de Costo" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#1A237E"/>
                <TextBlock Text="Registro de ventas y envíos" 
                           FontSize="14" 
                           Foreground="#666"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📄 PDF" 
                        Command="{Binding ExportarPDFCommand}"
                        Background="#E64A19" 
                        Foreground="White"
                        Padding="15,10"
                        Margin="0,0,10,0"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="📊 Excel" 
                        Command="{Binding ExportarExcelCommand}"
                        Background="#388E3C" 
                        Foreground="White"
                        Padding="15,10"
                        Margin="0,0,10,0"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="➕ Nueva Ficha" 
                        Command="{Binding CrearFichaCommand}"
                        Background="#1976D2" 
                        Foreground="White"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <!-- Filtros de fecha -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,15"
                Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>
                <DatePicker SelectedDate="{Binding FechaDesde}" 
                            Width="150"/>
                
                <TextBlock Text="Hasta:" 
                           VerticalAlignment="Center" 
                           Margin="20,0,10,0"/>
                <DatePicker SelectedDate="{Binding FechaHasta}" 
                            Width="150"/>
                
                <TextBox Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" 
                         Width="200" 
                         Padding="10,8"
                         Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Resumen -->
        <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Fichas: " FontSize="14"/>
                    <TextBlock Text="{Binding TotalFichas}" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#1565C0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Ventas: " FontSize="14"/>
                    <TextBlock Text="{Binding TotalVentas, StringFormat=C2}" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="#2E7D32"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        
        <!-- Lista de fichas -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Fichas}" 
                      SelectedItem="{Binding FichaSeleccionada}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="# Ficha" 
                                        Binding="{Binding NumeroFicha}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="Receptor" 
                                        Binding="{Binding NombreReceptor}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Tipo" 
                                        Binding="{Binding TipoPedido}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="Agencia" 
                                        Binding="{Binding NombreAgencia}" 
                                        Width="120"/>
                    <DataGridTextColumn Header="Fecha Envío" 
                                        Binding="{Binding FechaEnvio, StringFormat=d}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Precio USD" 
                                        Binding="{Binding PrecioVentaUSD, StringFormat=C2}" 
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

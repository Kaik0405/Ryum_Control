<UserControl x:Class="GestionApp.Views.FichasCostoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:FichasCostoViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F5F5F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:TipoPedidoColorConverter x:Key="TipoColor"/>
        <h:CurrencyFormatConverter x:Key="CurrencyFmt"/>
        <h:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 0: ENCABEZADO + ESTADÍSTICAS INLINE           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Fichas de Costo" 
                               FontSize="24" FontWeight="Bold" Foreground="#1A237E"/>
                </StackPanel>

                <!-- Badges de estadísticas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <!-- Fichas -->
                    <Border Background="#E3F2FD" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fichas " FontSize="11" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFichas}" FontSize="13" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Ventas -->
                    <Border Background="#E8F5E9" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ventas " FontSize="11" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVentas, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Costos -->
                    <Border Background="#FFEBEE" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Costos " FontSize="11" Foreground="#C62828" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCostos, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#C62828" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Ganancia -->
                    <Border Background="#F3E5F5" CornerRadius="10" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ganancia " FontSize="11" Foreground="#7B1FA2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalGanancia, StringFormat='${0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="#7B1FA2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botón refrescar -->
                <Button Grid.Column="3"
                        Command="{Binding RefrescarCommand}"
                        Background="Transparent"
                        BorderThickness="1" BorderBrush="#DDD"
                        Padding="10,6" Cursor="Hand" ToolTip="Recargar fichas"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderThickness="1" BorderBrush="#DDD">
                                <TextBlock Text="Actualizar" FontSize="12" FontWeight="SemiBold" Foreground="#555"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 1: FILTROS (Fechas + Búsqueda) — Diseño Pro  -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Desde (cápsula) -->
                <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="10" Padding="12,6" 
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Desde" FontSize="11" Foreground="#888" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}" Width="120" 
                                    VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Hasta (cápsula) -->
                <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="10" Padding="12,6"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hasta" FontSize="11" Foreground="#888" FontWeight="SemiBold" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}" Width="120" 
                                    VerticalAlignment="Center" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- Búsqueda (cápsula con icono) -->
                <Border Grid.Column="4" Background="#F8F9FA" CornerRadius="10" Padding="4,0"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EEEEEE" CornerRadius="8" 
                                Width="30" Height="30" Margin="2,3,0,3" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,7" FontSize="12" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar receptor, remitente, agencia..." 
                                                                       Foreground="#BBBBBB" Margin="10,0,0,0" FontSize="12"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 2: CATÁLOGO HORIZONTAL DE FICHAS              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- Catálogo principal -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="{Binding MostrarDetalle, Converter={StaticResource InvBoolToVis}}"
                          PanningMode="HorizontalOnly">
                <ItemsControl ItemsSource="{Binding FichasFiltradas}" Margin="0,0,0,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ═══ TARJETA DE FICHA DE COSTO ═══ -->
                            <Border Width="370" Margin="0,0,10,0" CornerRadius="12"
                                    BorderThickness="2" Background="White"
                                    BorderBrush="{Binding TipoPedido, Converter={StaticResource TipoColor}}"
                                    Cursor="Hand" VerticalAlignment="Stretch">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                  Command="{Binding DataContext.VerDetalleCommand, 
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- HEADER: Número + Tipo badge + Precio -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="14,10"
                                            Background="{Binding TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=bg}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NumeroFicha}" 
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{Binding TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=text}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                            Background="{Binding TipoPedido, Converter={StaticResource TipoColor}}">
                                                        <TextBlock Text="{Binding TipoPedido}" FontSize="9" 
                                                                   Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock FontSize="10" Foreground="#888" VerticalAlignment="Center">
                                                        <Run Text="{Binding Combo.Nombre, Mode=OneWay, FallbackValue=''}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PrecioVentaUSD, StringFormat='$ {0:N2}'}" 
                                                           FontSize="22" FontWeight="Bold"
                                                           Foreground="{Binding TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=text}"/>
                                                <TextBlock Text="USD" FontSize="9" Foreground="#999" 
                                                           FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,-2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- FECHAS: Envío y Entrega -->
                                    <Border Grid.Row="1" Padding="14,8,14,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FECHA ENVÍO" FontSize="8" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FechaEnvio, StringFormat='dd/MM/yyyy'}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#333"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="FECHA ENTREGA" FontSize="8" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding FechaEntrega, StringFormat='dd/MM/yyyy', TargetNullValue='Pendiente'}" 
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#333"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- PERSONAS: Envía → Recibe -->
                                    <Border Grid.Row="2" Padding="14,4,14,6" 
                                            BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ENVÍA" FontSize="8" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Remitente}" FontSize="11" 
                                                           Foreground="#444" TextTrimming="CharacterEllipsis"
                                                           FontWeight="Medium" ToolTip="{Binding Remitente}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" FontSize="16" 
                                                       Foreground="#CCC" Margin="8,8,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="RECIBE" FontSize="8" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding NombreReceptor}" FontSize="11" 
                                                           Foreground="#444" TextTrimming="CharacterEllipsis"
                                                           FontWeight="Medium" ToolTip="{Binding NombreReceptor}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- PRODUCTOS (tabla con columnas) -->
                                    <Border Grid.Row="3" Padding="10,6,10,0" MinHeight="80" MaxHeight="220">
                                        <StackPanel>
                                            <!-- Encabezado de tabla -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="PRODUCTO" FontSize="7.5" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="UM" FontSize="7.5" Foreground="#AAA" FontWeight="Bold" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="CANT" FontSize="7.5" Foreground="#AAA" FontWeight="Bold" TextAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="COSTO" FontSize="7.5" Foreground="#AAA" FontWeight="Bold" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="TOTAL" FontSize="7.5" Foreground="#AAA" FontWeight="Bold" TextAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="#EEEEEE" Margin="0,0,0,2"/>
                                            <!-- Filas de productos -->
                                            <ItemsControl ItemsSource="{Binding Productos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="42"/>
                                                                <ColumnDefinition Width="34"/>
                                                                <ColumnDefinition Width="52"/>
                                                                <ColumnDefinition Width="56"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding NombreProducto}" 
                                                                       FontSize="10" Foreground="#444" FontWeight="Medium"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       ToolTip="{Binding NombreProducto}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Unidad}" 
                                                                       FontSize="9" Foreground="#888" TextAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Cantidad, StringFormat='{}{0:G}'}" 
                                                                       FontSize="10" Foreground="#555" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                                                            <TextBlock Grid.Column="3" FontSize="10" Foreground="#666" TextAlignment="Right" VerticalAlignment="Center">
                                                                <Run Text="$"/><Run Text="{Binding CostoUnitario, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="4" FontSize="10" Foreground="#C62828" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center">
                                                                <Run Text="$"/><Run Text="{Binding Total, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Transportación al pie de la tabla -->
                                            <Border Height="1" Background="#E0E0E0" Margin="0,3,0,0"/>
                                            <Grid Margin="0,3,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Transportación" FontSize="10" 
                                                           Foreground="#E65100" FontWeight="Medium" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#E65100" FontWeight="SemiBold" 
                                                           TextAlignment="Right" VerticalAlignment="Center">
                                                    <Run Text="$"/><Run Text="{Binding CostoTransportacion, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- COSTO TOTAL + GANANCIA (pie de tarjeta) -->
                                    <Border Grid.Row="4" Padding="10,6,10,6" Background="#FAFAFA"
                                            BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="COSTO TOTAL" FontSize="8" Foreground="#AAA" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CostoTotal, StringFormat='$ {0:N2}'}" 
                                                           FontSize="16" FontWeight="Bold" Foreground="#C62828"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                                <TextBlock Text="GANANCIA" FontSize="8" Foreground="#AAA" FontWeight="Bold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Ganancia, StringFormat='$ {0:N2}'}" 
                                                           FontSize="14" FontWeight="Bold" Foreground="#2E7D32"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- BOTONES DE ACCIÓN -->
                                    <Border Grid.Row="5" Padding="8,6" CornerRadius="0,0,10,10"
                                            BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Info: Agencia + Dirección -->
                                            <TextBlock Grid.Column="0" FontSize="10" Foreground="#AAA"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DireccionReceptor}">
                                                <Run Text="{Binding NombreAgencia, Mode=OneWay}"/>
                                                <Run Text=" • " Foreground="#DDD"/>
                                                <Run Text="{Binding DireccionReceptor, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Ver detalle -->
                                            <Button Grid.Column="1" ToolTip="Ver detalle completo" Cursor="Hand"
                                                    Command="{Binding DataContext.VerDetalleCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Padding="10,5" Margin="0,0,4,0">
                                                            <TextBlock Text="Ver" FontSize="11" FontWeight="SemiBold" Foreground="#1565C0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Eliminar -->
                                            <Button Grid.Column="2" ToolTip="Eliminar ficha" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarFichaCommand, 
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Padding="10,5">
                                                            <TextBlock Text="Eliminar" FontSize="11" FontWeight="SemiBold" Foreground="#C62828"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#FFEBEE"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- (Panel vacío eliminado) -->

            <!-- ═══ PANEL DE DETALLE (superpuesto) ═══ -->
            <Border Visibility="{Binding MostrarDetalle, Converter={StaticResource BoolToVis}}"
                    Background="White" CornerRadius="12"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header del detalle -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="20,14"
                            Background="{Binding FichaSeleccionada.TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=bg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FICHA DE COSTO" FontSize="11" 
                                               Foreground="{Binding FichaSeleccionada.TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=text}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border CornerRadius="4" Padding="8,2"
                                            Background="{Binding FichaSeleccionada.TipoPedido, Converter={StaticResource TipoColor}}">
                                        <TextBlock Text="{Binding FichaSeleccionada.TipoPedido}" FontSize="10" 
                                                   Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding FichaSeleccionada.NumeroFicha}" 
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{Binding FichaSeleccionada.TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=text}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding FichaSeleccionada.PrecioVentaUSD, StringFormat='Precio: $ {0:N2} USD'}" 
                                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding FichaSeleccionada.TipoPedido, Converter={StaticResource TipoColor}, ConverterParameter=text}"
                                       Margin="0,0,20,0"/>
                            <!-- Cerrar -->
                            <Button Grid.Column="2" Command="{Binding CerrarDetalleCommand}" Cursor="Hand"
                                    VerticalAlignment="Top">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#FFFFFF" CornerRadius="14" 
                                                Width="28" Height="28" Opacity="0.8">
                                            <TextBlock Text="✕" FontSize="12" Foreground="#666"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FFEBEE"/>
                                                <Setter TargetName="bd" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Contenido del detalle -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15,20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Info envío (izquierda) -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Border Background="#F3E5F5" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                    <TextBlock Text="Datos del Envío" FontSize="11" FontWeight="Bold" Foreground="#7B1FA2"/>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FECHA ENVÍO" FontSize="9" Foreground="#AAA" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FichaSeleccionada.FechaEnvio, StringFormat='dd/MM/yyyy'}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="FECHA ENTREGA" FontSize="9" Foreground="#AAA" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FichaSeleccionada.FechaEntrega, StringFormat='dd/MM/yyyy', TargetNullValue='Pendiente'}" 
                                                   FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="TIPO DE PEDIDO" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,4,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FichaSeleccionada.TipoPedido}" FontSize="14" 
                                               FontWeight="SemiBold" Foreground="#333"/>
                                    <TextBlock Text=" — " Foreground="#CCC" FontSize="14"/>
                                    <TextBlock Text="{Binding FichaSeleccionada.Combo.Nombre, FallbackValue=''}" 
                                               FontSize="14" Foreground="#555"/>
                                </StackPanel>

                                <TextBlock Text="AGENCIA" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding FichaSeleccionada.NombreAgencia, TargetNullValue='—'}" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                            </StackPanel>

                            <!-- Personas (derecha) -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" Margin="0,0,0,10">
                                    <TextBlock Text="Personas" FontSize="11" FontWeight="Bold" Foreground="#2E7D32"/>
                                </Border>

                                <TextBlock Text="ENVÍA (REMITENTE)" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding FichaSeleccionada.Remitente}" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#333"/>

                                <TextBlock Text="RECIBE" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding FichaSeleccionada.NombreReceptor}" 
                                           FontSize="14" FontWeight="SemiBold" Foreground="#333"/>

                                <TextBlock Text="DIRECCIÓN" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding FichaSeleccionada.DireccionReceptor, TargetNullValue='—'}" 
                                           FontSize="13" Foreground="#555" TextWrapping="Wrap"/>

                                <TextBlock Text="TELÉFONO" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,10,0,2"/>
                                <TextBlock Text="{Binding FichaSeleccionada.TelefonoReceptor, TargetNullValue='—'}" 
                                           FontSize="13" Foreground="#555"/>
                            </StackPanel>

                            <!-- Tabla de productos con selección de inventario -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20,0,0"
                                    CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA">
                                <StackPanel>
                                    <Border Background="#F5F5F5" CornerRadius="8,8,0,0" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="PRODUCTO" FontSize="10" FontWeight="Bold" Foreground="#666"/>
                                            <TextBlock Grid.Column="1" Text="INVENTARIO" FontSize="10" FontWeight="Bold" Foreground="#1565C0" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="UM" FontSize="10" FontWeight="Bold" Foreground="#666" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="CANT." FontSize="10" FontWeight="Bold" Foreground="#666" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="COSTO" FontSize="10" FontWeight="Bold" Foreground="#666" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#666" TextAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="" FontSize="10"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding ProductosDetalle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,5" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Nombre del producto -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NombreProducto}" 
                                                                   FontSize="12" Foreground="#333" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- ComboBox selección de inventario -->
                                                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                                                  ItemsSource="{Binding ProductosDisponibles}"
                                                                  SelectedItem="{Binding ProductoSeleccionado}"
                                                                  DisplayMemberPath="Nombre"
                                                                  FontSize="10" Padding="4,3"
                                                                  VerticalAlignment="Center" Margin="4,0">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Nombre}" FontSize="10" Foreground="#333" Margin="0,0,6,0"/>
                                                                        <TextBlock FontSize="9" Foreground="#999">
                                                                            <Run Text="($"/><Run Text="{Binding CostoCompra, StringFormat='{}{0:N2}'}"/><Run Text=")"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <!-- UM -->
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Unidad}" 
                                                                   FontSize="12" Foreground="#666" TextAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Cantidad editable -->
                                                        <TextBox Grid.Row="0" Grid.Column="3" 
                                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G}'}" 
                                                                 FontSize="12" Foreground="#333" TextAlignment="Center"
                                                                 VerticalAlignment="Center" Padding="2,2"
                                                                 BorderBrush="#E0E0E0" BorderThickness="1" Background="White"/>
                                                        <!-- Costo unitario -->
                                                        <TextBlock Grid.Row="0" Grid.Column="4" 
                                                                   Text="{Binding CostoUnitario, StringFormat='$ {0:N2}'}" 
                                                                   FontSize="12" Foreground="#666" TextAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Total -->
                                                        <TextBlock Grid.Row="0" Grid.Column="5" FontSize="12" FontWeight="Bold" 
                                                                   Foreground="#C62828" TextAlignment="Right"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="$"/><Run Text="{Binding Total, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                        </TextBlock>
                                                        <!-- Botón dividir -->
                                                        <Button Grid.Row="0" Grid.Column="6" ToolTip="Dividir producto (usar múltiples fuentes)" Cursor="Hand"
                                                                Command="{Binding DataContext.DividirProductoCommand, 
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" Background="#F5F5F5" CornerRadius="4" 
                                                                            Width="26" Height="26">
                                                                        <TextBlock Text="✂" FontSize="12" Foreground="#757575"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <!-- Info stock debajo -->
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                                                   Text="{Binding InfoStock}" FontSize="9" Foreground="#999"
                                                                   Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Total + Transportación -->
                                    <Border Padding="14,10" Background="#EFEBE9" CornerRadius="0,0,8,8">
                                        <StackPanel>
                                            <!-- Fila transportación editable -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="TRANSPORTACIÓN" FontSize="11" FontWeight="Bold" 
                                                               Foreground="#E65100" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="$" FontSize="14" Foreground="#E65100" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Text="{Binding FichaSeleccionada.CostoTransportacion, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                                             Width="100" Padding="6,4" FontSize="14" FontWeight="Bold"
                                                             Foreground="#E65100" BorderBrush="#FFCC80" BorderThickness="1"
                                                             Background="#FFF8E1" TextAlignment="Right"
                                                             VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Fila total -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="TOTAL COSTO" 
                                                           FontSize="14" FontWeight="Bold" Foreground="#5D4037"/>
                                                <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#C62828">
                                                    <Run Text="$ "/><Run Text="{Binding FichaSeleccionada.CostoTotal, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Resumen financiero -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15,0,0"
                                    CornerRadius="8" Background="#F5F5F5" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="PRECIO VENTA" FontSize="9" Foreground="#AAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FichaSeleccionada.PrecioVentaUSD, StringFormat='$ {0:N2}'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="COSTO PROD." FontSize="9" Foreground="#AAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center">
                                            <Run Text="$ "/><Run Text="{Binding FichaSeleccionada.CostoTotal, Mode=OneWay, StringFormat='{}{0:N2}'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="TRANSPORTE" FontSize="9" Foreground="#AAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FichaSeleccionada.CostoTransportacion, StringFormat='$ {0:N2}'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="GANANCIA" FontSize="9" Foreground="#AAA" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FichaSeleccionada.Ganancia, StringFormat='$ {0:N2}'}" 
                                                   FontSize="18" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Botones de acción -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Estado inventario -->
                                    <Border CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FichaSeleccionada.InventarioDescontado}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⏳ Inventario pendiente"/>
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FichaSeleccionada.InventarioDescontado}" Value="True">
                                                            <Setter Property="Text" Value="✅ Inventario descontado"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Guardar cambios -->
                                    <Button Command="{Binding GuardarCostosCommand}" Cursor="Hand" Margin="0,0,8,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="White" CornerRadius="8" Padding="16,8"
                                                        BorderBrush="#4CAF50" BorderThickness="1.5">
                                                    <TextBlock x:Name="txt" Text="Guardar" FontSize="13" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#4CAF50"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Confirmar y descontar inventario -->
                                    <Button Command="{Binding ConfirmarInventarioCommand}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#1976D2" CornerRadius="8" Padding="16,8">
                                                    <TextBlock Text="📦 Confirmar y Descontar" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1565C0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Notas (si existen) -->
                            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                    Visibility="{Binding FichaSeleccionada.Notas, TargetNullValue=Collapsed, FallbackValue=Visible}">
                                <StackPanel>
                                    <TextBlock Text="OBSERVACIONES" FontSize="9" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding FichaSeleccionada.Notas}" FontSize="12" 
                                               Foreground="#555" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FILA 3: BARRA DE ESTADO                            -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,4">
            <TextBlock Text="{Binding MensajeEstado}" FontSize="11" Foreground="#999"/>
        </Border>
    </Grid>
</UserControl>

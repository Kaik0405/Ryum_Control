<UserControl x:Class="GestionApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Inicio" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#1A237E"/>
            <TextBlock Text="{Binding MesActual}" 
                       FontSize="14" 
                       Foreground="#666"/>
        </StackPanel>
        
        <!-- Tarjetas de resumen -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <!-- Fondos Actuales -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="💰 Fondos Actuales" 
                               FontSize="12" 
                               Foreground="#666" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding FondosActuales, StringFormat=C2}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#2E7D32"/>
                    <TextBlock Text="{Binding FondosIniciales, StringFormat='Inicial: {0:C2}'}" 
                               FontSize="11" 
                               Foreground="#999"/>
                </StackPanel>
            </Border>
            
            <!-- Ventas del Mes -->
            <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="📦 Ventas del Mes" 
                               FontSize="12" 
                               Foreground="#666" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding VentasDelMes}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#1565C0"/>
                    <TextBlock Text="fichas registradas" 
                               FontSize="11" 
                               Foreground="#999"/>
                </StackPanel>
            </Border>
            
            <!-- Ganancias -->
            <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="📈 Ingresos" 
                               FontSize="12" 
                               Foreground="#666" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding GananciasDelMes, StringFormat=C2}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#2E7D32"/>
                    <TextBlock Text="ingresos totales" 
                               FontSize="11" 
                               Foreground="#999"/>
                </StackPanel>
            </Border>
            
            <!-- Gastos -->
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="📉 Gastos" 
                               FontSize="12" 
                               Foreground="#666" 
                               Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding GastosDelMes, StringFormat=C2}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#C62828"/>
                    <TextBlock Text="egresos totales" 
                               FontSize="11" 
                               Foreground="#999"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        
        <!-- Área de contenido principal -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Panel izquierdo: Balance -->
            <Border Style="{StaticResource CardStyle}" 
                    Grid.Column="0" 
                    Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Balance del Mes" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"/>
                    
                    <Border Background="#E8F5E9" 
                            CornerRadius="5" 
                            Padding="15" 
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Balance: " 
                                       FontSize="14" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BalanceMes, StringFormat=C2}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock Text="Resumen del período actual" 
                               FontSize="12" 
                               Foreground="#666"/>
                </StackPanel>
            </Border>
            
            <!-- Panel derecho: Acciones rápidas -->
            <Border Style="{StaticResource CardStyle}" 
                    Grid.Column="1" 
                    Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Acciones Rápidas" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Selecciona una sección del menú para comenzar a trabajar." 
                               FontSize="13" 
                               Foreground="#666" 
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="• Inventario: Gestiona tus productos" 
                                   FontSize="12" 
                                   Margin="0,5"/>
                        <TextBlock Text="• Combos: Crea paquetes de productos" 
                                   FontSize="12" 
                                   Margin="0,5"/>
                        <TextBlock Text="• Fichas: Registra tus ventas" 
                                   FontSize="12" 
                                   Margin="0,5"/>
                        <TextBlock Text="• Movimientos: Controla ingresos y gastos" 
                                   FontSize="12" 
                                   Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="GestionApp.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ReportesViewModel}"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reportes" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#1A237E"/>
            <TextBlock Text="Genera reportes mensuales en PDF o Excel" 
                       FontSize="14" 
                       Foreground="#666"/>
        </StackPanel>
        
        <!-- Contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Panel de configuración -->
            <Border Style="{StaticResource CardStyle}" 
                    Grid.Column="0" 
                    Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Configuración del Reporte" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,20"/>
                    
                    <!-- Selección de período -->
                    <TextBlock Text="Período" 
                               FontSize="13" 
                               Foreground="#666" 
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <ComboBox ItemsSource="{Binding Meses}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Value"
                                  SelectedValue="{Binding MesSeleccionado}"
                                  Width="150"
                                  Padding="10,8"/>
                        <ComboBox ItemsSource="{Binding Años}"
                                  SelectedItem="{Binding AñoSeleccionado}"
                                  Width="100"
                                  Margin="10,0,0,0"
                                  Padding="10,8"/>
                    </StackPanel>
                    
                    <!-- Contenido a incluir -->
                    <TextBlock Text="Incluir en el reporte" 
                               FontSize="13" 
                               Foreground="#666" 
                               Margin="0,0,0,10"/>
                    
                    <CheckBox Content="Fichas de Costo" 
                              IsChecked="{Binding IncluirFichasCosto}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="Movimientos Financieros" 
                              IsChecked="{Binding IncluirMovimientos}"
                              Margin="0,0,0,8"/>
                    <CheckBox Content="Resumen Financiero" 
                              IsChecked="{Binding IncluirResumenFinanciero}"
                              Margin="0,0,0,20"/>
                    
                    <!-- Botones de acción -->
                    <Button Content="📄 Generar PDF" 
                            Command="{Binding GenerarReportePDFCommand}"
                            Background="#E64A19" 
                            Foreground="White"
                            Padding="15,12"
                            Margin="0,0,0,10"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            FontSize="14"/>
                    
                    <Button Content="📊 Generar Excel" 
                            Command="{Binding GenerarReporteExcelCommand}"
                            Background="#388E3C" 
                            Foreground="White"
                            Padding="15,12"
                            Margin="0,0,0,20"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            FontSize="14"/>
                    
                    <!-- Estado -->
                    <TextBlock Text="{Binding UltimoReporteGenerado}" 
                               FontSize="12" 
                               Foreground="#666"
                               TextWrapping="Wrap"
                               Visibility="{Binding UltimoReporteGenerado, Converter={x:Null}}"/>
                </StackPanel>
            </Border>
            
            <!-- Vista previa / Información -->
            <Border Style="{StaticResource CardStyle}" 
                    Grid.Column="1">
                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center">
                    <TextBlock Text="📈" 
                               FontSize="64" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Vista Previa del Reporte" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Configura las opciones del reporte en el panel izquierdo y genera tu reporte en el formato deseado." 
                               FontSize="13" 
                               Foreground="#666"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="300"/>
                    
                    <Button Content="👁️ Vista Previa" 
                            Command="{Binding VistaPreviewCommand}"
                            Background="#1976D2" 
                            Foreground="White"
                            Padding="20,12"
                            Margin="0,30,0,0"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

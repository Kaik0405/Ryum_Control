<UserControl x:Class="GestionApp.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#F5F5F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,20">
        <StackPanel MaxWidth="800">

            <!-- ═══ HEADER ═══ -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="⚙️ Ajustes" FontSize="24" FontWeight="Bold" Foreground="#1A237E"/>
                <TextBlock Text="Configura los datos del distribuidor, agencias de envío y preferencias" 
                           FontSize="13" Foreground="#888" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: DATOS DEL DISTRIBUIDOR                -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- Título sección -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="#E3F2FD" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="👤" FontSize="16"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Datos del Distribuidor" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="Información que aparece en fichas de costo y modelos de conformidad" 
                                       FontSize="11" Foreground="#999"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Campos en grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Nombre -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="NOMBRE DEL DISTRIBUIDOR *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistNombre, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                        </StackPanel>

                        <!-- Nombre Negocio -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="NOMBRE DEL NEGOCIO" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistNombreNegocio, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                        </StackPanel>

                        <!-- Teléfono -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="TELÉFONO" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistTelefono, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                        </StackPanel>

                        <!-- Dirección -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="DIRECCIÓN" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistDireccion, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                        </StackPanel>

                        <!-- Prefijo Ficha -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="PREFIJO FICHAS DE COSTO" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistPrefijoFicha, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD" MaxWidth="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Prefijo Conformidad -->
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="PREFIJO CONFORMIDAD" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DistPrefijoConformidad, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="10,8" FontSize="13" BorderBrush="#DDD" MaxWidth="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Tasa de cambio USD → CUP -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="💱 TASA DE CAMBIO (1 USD = ? CUP)" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1 USD =" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding DistTasaCambio, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" 
                                         Padding="10,8" FontSize="16" FontWeight="Bold" BorderBrush="#DDD" 
                                         Width="120" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="CUP" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#E65100" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Center">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="12,8">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#E65100">
                                    <Run FontWeight="Bold" Text="💡 Importante:"/>
                                    <Run Text=" Esta tasa se usa para calcular la ganancia real. El precio del combo (USD) se convierte a CUP y se resta el costo de los productos para obtener la ganancia."/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Botón guardar -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding GuardarDistribuidorCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1565C0" CornerRadius="6" Padding="24,10">
                                            <TextBlock Text="💾 Guardar datos" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: AGENCIAS DE ENVÍO                     -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- Título + Botón nueva -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="🏢" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Agencias de Envío" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Gestiona las agencias disponibles para entregas" 
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding NuevaAgenciaCommand}" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#E8F5E9" CornerRadius="6" Padding="16,8">
                                        <TextBlock Text="+ Nueva Agencia" FontWeight="SemiBold" FontSize="12" Foreground="#2E7D32"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Lista de agencias -->
                    <ItemsControl ItemsSource="{Binding Agencias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8"
                                        BorderBrush="#E8E8E8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" 
                                                Background="#F5F5F5" Margin="0,0,14,0">
                                            <Image Source="{Binding Nombre, Converter={StaticResource AgenciaLogo}}"
                                                   Width="36" Height="36"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Activa"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="Inactiva"/>
                                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="#999" Margin="0,2,0,0">
                                                <Run Text="{Binding Telefono, Mode=OneWay, TargetNullValue=''}"/>
                                                <Run Text="{Binding Direccion, Mode=OneWay, TargetNullValue=''}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Botones -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Toggle activo -->
                                            <Button ToolTip="Activar/Desactivar" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleActivoAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="⏻" FontSize="14" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Editar -->
                                            <Button ToolTip="Editar" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditarAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#E3F2FD" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="✏️" FontSize="13" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Eliminar -->
                                            <Button ToolTip="Eliminar" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#FFEBEE" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="🗑️" FontSize="13" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Formulario de agencia (overlay inline) -->
                    <Border Visibility="{Binding MostrarFormAgencia, Converter={StaticResource BoolToVis}}"
                            Background="#F8F9FF" CornerRadius="8" Padding="20,16" Margin="0,8,0,0"
                            BorderBrush="#C5CAE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nueva Agencia"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsEdicionAgencia}" Value="True">
                                                <Setter Property="Text" Value="Editar Agencia"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo preview + botón -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="10" Background="#EEEEEE"
                                            BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8">
                                        <Image Source="{Binding FormAgLogoPreview}" 
                                               Width="64" Height="64"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding SeleccionarLogoCommand}" Cursor="Hand"
                                            HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#E8EAF6" CornerRadius="4" Padding="10,4">
                                                    <TextBlock Text="📁 Logo" FontSize="11" Foreground="#3F51B5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#C5CAE9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Campos -->
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="NOMBRE *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgNombre, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="TELÉFONO" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgTelefono, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                        <TextBlock Text="DIRECCIÓN" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgDireccion, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                        <TextBlock Text="NOTAS" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgNotas, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Botones guardar/cancelar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Command="{Binding CancelarAgenciaCommand}" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="White" CornerRadius="6" Padding="16,8"
                                                    BorderBrush="#DDD" BorderThickness="1">
                                                <TextBlock Text="Cancelar" FontSize="12" Foreground="#666"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding GuardarAgenciaCommand}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#1565C0" CornerRadius="6" Padding="20,8">
                                                <TextBlock Text="Guardar Agencia" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: INFORMACIÓN DE LA APP                 -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#F3E5F5" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="ℹ️" FontSize="16"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Información" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="Datos de la aplicación" FontSize="11" Foreground="#999"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="#666" Margin="0,0,0,4">
                        <Run Text="Aplicación: " FontWeight="Bold"/>
                        <Run Text="Ryum Control — Sistema de Gestión"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#666" Margin="0,0,0,4">
                        <Run Text="Base de datos: " FontWeight="Bold"/>
                        <Run Text="SQLite (local)"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#666">
                        <Run Text="Ruta BD: " FontWeight="Bold"/>
                        <Run Text="%AppData%/GestionApp/gestion.db"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="#666" 
                       Margin="0,0,0,20" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="GestionApp.Views.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:h="clr-namespace:GestionApp.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#F5F5F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,20">
        <StackPanel MaxWidth="800">

            <!-- ═══ HEADER ═══ -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="⚙️ Ajustes" FontSize="24" FontWeight="Bold" Foreground="#1A237E"/>
                <TextBlock Text="Configuración general y agencias de envío" 
                           FontSize="13" Foreground="#888" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ═════════════════════════════════════════════════ -->
            <!-- SECCIÓN: TASA DE CAMBIO (siempre editable)       -->
            <!-- ═════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="💱" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tasa de Cambio" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Se usa para calcular la ganancia real en fichas de costo" 
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="1 USD =" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding DistTasaCambio, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" 
                                     Padding="12,8" FontSize="18" FontWeight="Bold" BorderBrush="#DDD" 
                                     Width="130" HorizontalAlignment="Left"/>
                            <TextBlock Text="CUP" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#E65100" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Botón guardar tasa -->
                    <Button Grid.Column="1" Command="{Binding GuardarTasaCommand}" Cursor="Hand"
                            VerticalAlignment="Bottom">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#E65100" CornerRadius="6" Padding="20,10">
                                    <TextBlock Text="💾 Guardar tasa" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#BF360C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═════════════════════════════════════════════════ -->
            <!-- SECCIÓN: DATOS DEL DISTRIBUIDOR                  -->
            <!-- ═════════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- Título + botón editar -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Datos del Distribuidor" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Información que aparece en fichas y conformidades" 
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Botón editar (solo visible cuando NO está en modo edición) -->
                        <Button Grid.Column="1" Command="{Binding EditarDistribuidorCommand}" Cursor="Hand"
                                Visibility="{Binding ModoEdicion, Converter={StaticResource InvBoolToVis}}"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#E3F2FD" CornerRadius="6" Padding="14,7">
                                        <TextBlock Text="✏️ Editar" FontWeight="SemiBold" FontSize="12" Foreground="#1565C0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- ═══ MODO LECTURA ═══ -->
                    <StackPanel Visibility="{Binding ModoEdicion, Converter={StaticResource InvBoolToVis}}">
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Nombre -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NOMBRE" FontSize="10" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DistNombre}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                            </StackPanel>
                            
                            <!-- Prefijo Ficha -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PREFIJO FICHAS" FontSize="10" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Background="#F5F5F5" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding DistPrefijoFicha}" FontSize="13" Foreground="#555" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Prefijo Conformidad -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PREFIJO CONFORMIDAD" FontSize="10" Foreground="#AAA" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Background="#F5F5F5" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding DistPrefijoConformidad}" FontSize="13" Foreground="#555" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ═══ MODO EDICIÓN ═══ -->
                    <StackPanel Visibility="{Binding ModoEdicion, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nombre -->
                            <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="NOMBRE DEL DISTRIBUIDOR *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DistNombre, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="10,8" FontSize="13" BorderBrush="#DDD"/>
                            </StackPanel>

                            <!-- Prefijo Ficha -->
                            <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="PREFIJO FICHAS" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DistPrefijoFicha, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="10,8" FontSize="13" BorderBrush="#DDD" MaxWidth="150" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Prefijo Conformidad -->
                            <StackPanel Grid.Column="4" Margin="0,0,0,12">
                                <TextBlock Text="PREFIJO CONFORMIDAD" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DistPrefijoConformidad, UpdateSourceTrigger=PropertyChanged}" 
                                         Padding="10,8" FontSize="13" BorderBrush="#DDD" MaxWidth="150" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>

                        <!-- Botones guardar/cancelar -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding CancelarEdicionCommand}" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="White" CornerRadius="6" Padding="16,8"
                                                BorderBrush="#DDD" BorderThickness="1">
                                            <TextBlock Text="Cancelar" FontSize="12" Foreground="#666"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding GuardarDistribuidorCommand}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1565C0" CornerRadius="6" Padding="20,8">
                                            <TextBlock Text="💾 Guardar" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: AGENCIAS DE ENVÍO                     -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <!-- Título + Botón nueva -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="🏢" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Agencias de Envío" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Gestiona las agencias disponibles para entregas" 
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding NuevaAgenciaCommand}" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#E8F5E9" CornerRadius="6" Padding="16,8">
                                        <TextBlock Text="+ Nueva Agencia" FontWeight="SemiBold" FontSize="12" Foreground="#2E7D32"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Lista de agencias -->
                    <ItemsControl ItemsSource="{Binding Agencias}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="8"
                                        BorderBrush="#E8E8E8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Logo -->
                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" 
                                                Background="#F5F5F5" Margin="0,0,14,0">
                                            <Image Source="{Binding Nombre, Converter={StaticResource AgenciaLogo}}"
                                                   Width="36" Height="36"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Activa"/>
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                        <Setter Property="Text" Value="Inactiva"/>
                                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Foreground="#999" Margin="0,2,0,0">
                                                <Run Text="{Binding Telefono, Mode=OneWay, TargetNullValue=''}"/>
                                                <Run Text="{Binding Direccion, Mode=OneWay, TargetNullValue=''}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Botones -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Toggle activo -->
                                            <Button ToolTip="Activar/Desactivar" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.ToggleActivoAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#F5F5F5" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="⏻" FontSize="14" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Editar -->
                                            <Button ToolTip="Editar" Cursor="Hand" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EditarAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#E3F2FD" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="✏️" FontSize="13" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#BBDEFB"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Eliminar -->
                                            <Button ToolTip="Eliminar" Cursor="Hand"
                                                    Command="{Binding DataContext.EliminarAgenciaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#FFEBEE" CornerRadius="6" 
                                                                Width="32" Height="32">
                                                            <TextBlock Text="🗑️" FontSize="13" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#FFCDD2"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Formulario de agencia (overlay inline) -->
                    <Border Visibility="{Binding MostrarFormAgencia, Converter={StaticResource BoolToVis}}"
                            Background="#F8F9FF" CornerRadius="8" Padding="20,16" Margin="0,8,0,0"
                            BorderBrush="#C5CAE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Nueva Agencia"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsEdicionAgencia}" Value="True">
                                                <Setter Property="Text" Value="Editar Agencia"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo preview + botón -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="10" Background="#EEEEEE"
                                            BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,8">
                                        <Image Source="{Binding FormAgLogoPreview}" 
                                               Width="64" Height="64"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding SeleccionarLogoCommand}" Cursor="Hand"
                                            HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#E8EAF6" CornerRadius="4" Padding="10,4">
                                                    <TextBlock Text="📁 Logo" FontSize="11" Foreground="#3F51B5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#C5CAE9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Campos -->
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                        <TextBlock Text="NOMBRE *" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgNombre, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Text="TELÉFONO" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgTelefono, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                                        <TextBlock Text="DIRECCIÓN" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgDireccion, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                        <TextBlock Text="NOTAS" FontSize="10" Foreground="#888" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding FormAgNotas, UpdateSourceTrigger=PropertyChanged}" 
                                                 Padding="8,6" FontSize="12" BorderBrush="#DDD"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Botones guardar/cancelar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Command="{Binding CancelarAgenciaCommand}" Cursor="Hand" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="White" CornerRadius="6" Padding="16,8"
                                                    BorderBrush="#DDD" BorderThickness="1">
                                                <TextBlock Text="Cancelar" FontSize="12" Foreground="#666"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding GuardarAgenciaCommand}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#1565C0" CornerRadius="6" Padding="20,8">
                                                <TextBlock Text="Guardar Agencia" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: RUTA DE REPORTES PDF                  -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="📄" FontSize="16"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ruta de Reportes PDF" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Carpeta donde se guardan los reportes generados" 
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{Binding RutaReportes}" FontSize="12" Foreground="#555" 
                                       FontFamily="Consolas" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Command="{Binding CambiarRutaReportesCommand}" Cursor="Hand"
                            VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#E8F5E9" CornerRadius="6" Padding="20,10">
                                    <TextBlock Text="📁 Cambiar" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#C8E6C9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- SECCIÓN: GESTIÓN DE DATOS                      -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Background="White" CornerRadius="10" Padding="24,20" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#F3E5F5" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="🗄️" FontSize="16"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Gestión de Datos" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            <TextBlock Text="Información sobre el almacenamiento local" FontSize="11" Foreground="#999"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Background="#FAFAFA" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Motor:" FontSize="12" Foreground="#888" 
                                       FontWeight="SemiBold" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="SQLite (local)" FontSize="12" Foreground="#555"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ubicación:" FontSize="12" Foreground="#888" 
                                       FontWeight="SemiBold" Margin="0,0,16,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="%AppData%/GestionApp/gestion.db" FontSize="12" 
                                       Foreground="#555" FontFamily="Consolas" TextWrapping="Wrap"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Logos:" FontSize="12" Foreground="#888" 
                                       FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="%AppData%/GestionApp/Logos/" FontSize="12" 
                                       Foreground="#555" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="#FFF8E1" CornerRadius="6" Padding="12,8">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#F57F17">
                            <Run FontWeight="Bold" Text="💡"/>
                            <Run Text=" Para hacer respaldo, copia la carpeta %AppData%/GestionApp completa a un lugar seguro."/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="#666" 
                       Margin="0,0,0,20" HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

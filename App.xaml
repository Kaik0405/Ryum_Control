<Application x:Class="GestionApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GestionApp"
             xmlns:vm="clr-namespace:GestionApp.ViewModels"
             xmlns:views="clr-namespace:GestionApp.Views"
             xmlns:h="clr-namespace:GestionApp.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <!-- RYUM CONTROL / MARINE: navy, white, warm gold. -->
            <Color x:Key="Navy900">#0D2945</Color>
            <Color x:Key="Navy800">#123B5C</Color>
            <Color x:Key="Navy700">#1B5278</Color>
            <Color x:Key="Navy100">#EAF1F7</Color>
            <Color x:Key="CanvasColor">#EEF3F8</Color>
            <Color x:Key="InkColor">#17324B</Color>
            <Color x:Key="MutedColor">#667D92</Color>
            <Color x:Key="BorderColor">#DCE5EE</Color>
            <Color x:Key="GoldColor">#D8AD37</Color>

            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
            <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy800}"/>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
            <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}"/>
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="GlassBrush" Color="#E8FFFFFF"/>
            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#123B5C" Offset="0"/>
                <GradientStop Color="#1E587B" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8C75A" Offset="0"/>
                <GradientStop Color="#C99B27" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0B2741" Offset="0"/>
                <GradientStop Color="#123B5C" Offset="0.52"/>
                <GradientStop Color="#0B2239" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#173F63" Offset="0"/>
                <GradientStop Color="#2E6A8E" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F1FFFFFF" Offset="0"/>
                <GradientStop Color="#EAF5F9FC" Offset="1"/>
            </LinearGradientBrush>
            <DropShadowEffect x:Key="SoftGlowEffect" Color="#D8AD37" BlurRadius="18" ShadowDepth="0" Opacity="0.18"/>

            <h:MenuCheckConverter x:Key="MenuCheckConverter"/>
            <h:AgenciaLogoConverter x:Key="AgenciaLogo"/>
            <h:FechaMasUnDiaConverter x:Key="FechaMasUnDia"/>

            <!-- Navigation: ViewModel -> View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventarioViewModel}"><views:InventarioView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CombosViewModel}"><views:CombosView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EntregasViewModel}"><views:EntregasView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:FichasCostoViewModel}"><views:FichasCostoView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MovimientosViewModel}"><views:MovimientosView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}"><views:ReportesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AjustesViewModel}"><views:AjustesView/></DataTemplate>

            <!-- Navigation rail. -->
            <Style x:Key="SidebarNavStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#C7D6E3"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,11"/>
                <Setter Property="Margin" Value="0,2,0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="NavIndicator" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="Transparent"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#27496B"/>
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="#456987"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#315675"/>
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="#D8AD37"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="NavIndicator" Property="Background" Value="#E3BF4D"/>
                                    <Setter TargetName="NavIndicator" Property="Height" Value="24"/>
                                    <Setter TargetName="NavIndicator" Property="Width" Value="4"/>
                                    <Setter TargetName="NavSurface" Property="Effect" Value="{StaticResource SoftGlowEffect}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="NavSurface" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavSurface"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="3" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavSurface"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared card surface with soft elevation. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassGradient}"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="BorderBrush" Value="#DCE5EE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
                <Setter Property="Effect">
                    <Setter.Value><DropShadowEffect Color="#19324A" BlurRadius="18" ShadowDepth="2" Opacity="0.09"/></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.004" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.004" Duration="0:0:0.16"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- Reusable micro-interaction for catalog cards. -->
            <Style x:Key="InteractiveCardStyle" TargetType="Border">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.16"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- Buttons animate even when a view supplies its own ControlTemplate. -->
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
                <Setter Property="BorderBrush" Value="#244F70"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#D8AD37"/>
                                    <Setter TargetName="ButtonSurface" Property="Effect"><Setter.Value><DropShadowEffect Color="#D8AD37" BlurRadius="12" ShadowDepth="0" Opacity="0.18"/></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.13"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.13"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- Text input: high contrast, clear focus ring, no dense borders. -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="CaretBrush" Value="#C69B2D"/>
                <Setter Property="SelectionBrush" Value="#BBD2E5"/>
                <Setter Property="BorderBrush" Value="#CBD8E5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                                <Border x:Name="FocusRing" BorderBrush="#D6AE3A" BorderThickness="1.4"
                                        CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#7898B2"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#C69B2D"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="1.4"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Background" Value="#F0F3F6"/><Setter TargetName="InputBorder" Property="Opacity" Value="0.58"/></Trigger>
                                <EventTrigger RoutedEvent="UIElement.GotKeyboardFocus"><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                                </Storyboard></BeginStoryboard></EventTrigger>
                                <EventTrigger RoutedEvent="UIElement.LostKeyboardFocus"><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                </Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Keep WPF's native ComboBox template; style only its surfaces. -->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD8E5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#7898B2"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#C69B2D"/><Setter Property="BorderThickness" Value="1.5"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" Margin="2,1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EAF1F7"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DCE9F4"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- IMPORTANT: native DatePicker template preserves the calendar parts/layout. -->
            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD8E5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="148"/>
                <Setter Property="MinHeight" Value="34"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#C69B2D"/><Setter Property="BorderThickness" Value="1.5"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="2,1"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style TargetType="Calendar">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="BorderBrush" Value="#DCE5EE"/>
            </Style>
            <Style TargetType="CalendarDayButton">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="MinWidth" Value="30"/>
                <Setter Property="MinHeight" Value="28"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAF1F7"/><Setter Property="Foreground" Value="#123B5C"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8C75A"/><Setter Property="Foreground" Value="#17324B"/><Setter Property="FontWeight" Value="Bold"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="CalendarButton">
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="Background" Value="White"/>
            </Style>

            <!-- Checkboxes and radio options animate their selected state. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#405A70"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4"
                                        BorderThickness="1.2" BorderBrush="#9CB0C2" Background="White"
                                        VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    <Path x:Name="CheckMark" Data="M2,8 L6,12 L14,3" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Stretch="Uniform" Margin="2"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#173F63"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#173F63"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#C69B2D"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
                                <EventTrigger RoutedEvent="ToggleButton.Checked"><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CheckSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.82" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="CheckSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.82" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="#405A70"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse x:Name="RadioRing" Width="14" Height="14" Stroke="#9CB0C2" StrokeThickness="1.4" Fill="White" VerticalAlignment="Center"/>
                                <Ellipse x:Name="RadioDot" Width="6" Height="6" Fill="#E0B63D" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioRing" Property="Stroke" Value="#173F63"/><Setter TargetName="RadioRing" Property="Fill" Value="#173F63"/><Setter TargetName="RadioDot" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#17324B"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioRing" Property="Stroke" Value="#C69B2D"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                <EventTrigger RoutedEvent="ToggleButton.Checked"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="RadioDot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Data tables: white rows, restrained separators and readable selection. -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#203B54"/>
                <Setter Property="BorderBrush" Value="#DCE5EE"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF3"/>
                <Setter Property="VerticalGridLinesBrush" Value="#EDF1F5"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#EAF1F7"/>
                <Setter Property="Foreground" Value="#24465F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="13,11"/>
                <Setter Property="BorderBrush" Value="#D9E3EC"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#203B54"/>
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F6FA"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEAF5"/><Setter Property="Foreground" Value="#17324B"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="#203B54"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,8"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#17324B"/></Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#17324B"/>
                <Setter Property="BorderBrush" Value="#DCE5EE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>
        </ResourceDictionary>
